# Backup old configs during reinstall
.dotfiles-backup/

# Wallpapers are user-specific
wallpapers/

# Editor/OS noise
*.swp
*.save
*~
.DS_Store

# Python bytecode from local/bin helpers
__pycache__/
*.pyc

# Machine-local caches that must not be committed
config/btop/btop.log

# Ad-hoc backups (*.bak-store-base, *.bak-handwritten, ...)
*.bak-*

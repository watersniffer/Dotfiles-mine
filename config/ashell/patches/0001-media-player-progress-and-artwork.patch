+    /// Poll the current position (microseconds) of every known player.
+    ///
+    /// MPRIS has no `PositionChanged` signal, so positions have to be polled.
+    /// This deliberately bypasses the proxy's `Position` property getter: zbus
+    /// serves `#[zbus(property)]` getters from an internal cache that is only
+    /// refreshed by `PropertiesChanged` signals, which MPRIS never emits for
+    /// `Position`. Going through `org.freedesktop.DBus.Properties.Get` hits the
+    /// player every time. The proxies are cloned out so the returned future is
+    /// `'static` and does not borrow the service — `iced::Task` requires that.
+    pub fn position_fetcher(
+        &self,
+    ) -> impl std::future::Future<Output = Vec<(String, Option<i64>)>> + Send + 'static {
+        let targets: Vec<(String, zbus::Connection)> = self
+            .data
+            .iter()
+            .map(|p| (p.service.clone(), self.conn.clone()))
+            .collect();
+        async move {
+            let mut out = Vec::with_capacity(targets.len());
+            for (service, conn) in targets {
+                let pos = match zbus::Proxy::new(
+                    &conn,
+                    service.clone(),
+                    "/org/mpris/MediaPlayer2",
+                    "org.freedesktop.DBus.Properties",
+                )
+                .await
+                {
+                    Ok(props) => props
+                        .call("Get", &("org.mpris.MediaPlayer2.Player", "Position"))
+                        .await
+                        .ok()
+                        .and_then(|v| OwnedValue::try_into(v).ok()),
+                    Err(_) => None,
+                };
+                out.push((service, pos));
+            }
+            out
+        }
+    }
 }
 

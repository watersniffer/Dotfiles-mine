+/// A stand-in tile for players that publish no artwork at all.
+///
+/// Radio streams and some web players set neither `mpris:artUrl` nor an
+/// `og:image`, so there is nothing real to show. Rather than leaving a gap in
+/// the row, draw a tile whose colour and initial are derived from the track
+/// name, so a given track always looks the same.
+fn placeholder_tile(
+    title: &str,
+    artists: &str,
+    palette: &iced::theme::Palette,
+    font_size: FontSize,
+    radius: Radius,
+) -> Element<'static, Message> {
+    // FNV-1a over the track name: stable across restarts, unlike DefaultHasher.
+    let mut hash: u64 = 0xcbf2_9ce4_8422_2325;
+    for byte in title.as_bytes().iter().chain(artists.as_bytes()) {
+        hash ^= u64::from(*byte);
+        hash = hash.wrapping_mul(0x0000_0100_0000_01b3);
+    }
+    let accents = [
+        palette.primary,
+        palette.success,
+        palette.warning,
+        palette.danger,
+    ];
+    let accent = accents[(hash % accents.len() as u64) as usize];
+
+    let initial = title
+        .chars()
+        .find(|c| c.is_alphanumeric())
+        .map(|c| c.to_uppercase().to_string())
+        .unwrap_or_else(|| "\u{266b}".to_string()); // music note
+
+    container(
+        text(initial)
+            .size(font_size.xl)
+            .color(accent.scale_alpha(0.9)),
+    )
+    .center_x(64)
+    .center_y(64)
+    .style(move |_: &iced::Theme| container::Style {
+        background: Some(Background::Color(accent.scale_alpha(0.20))),
+        text_color: Some(accent),
+        border: Border {
+            color: accent.scale_alpha(0.45),
+            width: 1.0,
+            radius: radius.md.into(),
+        },
+        ..container::Style::default()
+    })
+    .into()
+}

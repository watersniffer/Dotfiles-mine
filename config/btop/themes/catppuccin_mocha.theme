# Catppuccin Mocha theme for btop++. Generated by theme-apply --
# edit themes/catppuccin-mocha/palette.conf.

# Main background, empty for terminal default
theme[main_bg]="#1e1e2e"

# Main text color
theme[main_fg]="#cdd6f4"

# Title color for boxes
theme[title]="#cdd6f4"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#cba6f7"

# Background color of selected item in processes box
theme[selected_bg]="#45475a"

# Foreground color of selected item in processes box
theme[selected_fg]="#cdd6f4"

# Color of inactive/disabled text
theme[inactive_fg]="#6c7086"

# Colors for cpu box
theme[cpu_box]="#89b4fa"
theme[cpu_bar]="#89b4fa"
theme[cpu_text]="#cdd6f4"

# Colors for mem box
theme[mem_box]="#cba6f7"
theme[mem_bar]="#cba6f7"
theme[mem_text]="#cdd6f4"
theme[mem_cache]="#45475a"

# Colors for net box
theme[net_box]="#94e2d5"
theme[net_text]="#cdd6f4"
theme[net_up]="#a6e3a1"
theme[net_down]="#89b4fa"

# Colors for processes box
theme[proc_box]="#94e2d5"
theme[proc_misc]="#6c7086"
theme[proc_bar]="#89b4fa"
theme[proc_bar_bg]="#313244"
theme[proc_text]="#cdd6f4"

# Colors for gpu box
theme[gpu_box]="#cba6f7"
theme[gpu_text]="#cdd6f4"

# Colors for temp box
theme[temp_box]="#f9e2af"
theme[temp_text]="#cdd6f4"
theme[temp_start]="#a6e3a1"
theme[temp_mid]="#f9e2af"
theme[temp_end]="#f38ba8"

# Colors for fan box
theme[fan_box]="#94e2d5"
theme[fan_text]="#cdd6f4"
theme[fan_speed]="#cdd6f4"
theme[fan_start]="#a6e3a1"
theme[fan_mid]="#f9e2af"
theme[fan_end]="#f38ba8"

# E-ink theme for btop++. Generated by theme-apply --
# edit themes/e-ink/palette.conf.

# Main background, empty for terminal default
theme[main_bg]="#0d0d0d"

# Main text color
theme[main_fg]="#f2f2f2"

# Title color for boxes
theme[title]="#f2f2f2"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#f2f2f2"

# Background color of selected item in processes box
theme[selected_bg]="#262626"

# Foreground color of selected item in processes box
theme[selected_fg]="#f2f2f2"

# Color of inactive/disabled text
theme[inactive_fg]="#767676"

# Colors for cpu box
theme[cpu_box]="#a8a8a8"
theme[cpu_bar]="#a8a8a8"
theme[cpu_text]="#f2f2f2"

# Colors for mem box
theme[mem_box]="#e0e0e0"
theme[mem_bar]="#e0e0e0"
theme[mem_text]="#f2f2f2"
theme[mem_cache]="#262626"

# Colors for net box
theme[net_box]="#b2b2b2"
theme[net_text]="#f2f2f2"
theme[net_up]="#bdbdbd"
theme[net_down]="#a8a8a8"

# Colors for processes box
theme[proc_box]="#b2b2b2"
theme[proc_misc]="#767676"
theme[proc_bar]="#a8a8a8"
theme[proc_bar_bg]="#1a1a1a"
theme[proc_text]="#f2f2f2"

# Colors for gpu box
theme[gpu_box]="#e0e0e0"
theme[gpu_text]="#f2f2f2"

# Colors for temp box
theme[temp_box]="#c8c8c8"
theme[temp_text]="#f2f2f2"
theme[temp_start]="#bdbdbd"
theme[temp_mid]="#c8c8c8"
theme[temp_end]="#ffffff"

# Colors for fan box
theme[fan_box]="#b2b2b2"
theme[fan_text]="#f2f2f2"
theme[fan_speed]="#f2f2f2"
theme[fan_start]="#bdbdbd"
theme[fan_mid]="#c8c8c8"
theme[fan_end]="#ffffff"

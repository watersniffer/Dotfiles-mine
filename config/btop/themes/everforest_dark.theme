# Everforest Dark theme for btop++. Generated by theme-apply --
# edit themes/everforest-dark/palette.conf.

# Main background, empty for terminal default
theme[main_bg]="#2d353b"

# Main text color
theme[main_fg]="#d3c6aa"

# Title color for boxes
theme[title]="#d3c6aa"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#a7c080"

# Background color of selected item in processes box
theme[selected_bg]="#3d484d"

# Foreground color of selected item in processes box
theme[selected_fg]="#d3c6aa"

# Color of inactive/disabled text
theme[inactive_fg]="#859289"

# Colors for cpu box
theme[cpu_box]="#7fbbb3"
theme[cpu_bar]="#7fbbb3"
theme[cpu_text]="#d3c6aa"

# Colors for mem box
theme[mem_box]="#d699b6"
theme[mem_bar]="#d699b6"
theme[mem_text]="#d3c6aa"
theme[mem_cache]="#3d484d"

# Colors for net box
theme[net_box]="#83c092"
theme[net_text]="#d3c6aa"
theme[net_up]="#a7c080"
theme[net_down]="#7fbbb3"

# Colors for processes box
theme[proc_box]="#83c092"
theme[proc_misc]="#859289"
theme[proc_bar]="#7fbbb3"
theme[proc_bar_bg]="#343f44"
theme[proc_text]="#d3c6aa"

# Colors for gpu box
theme[gpu_box]="#d699b6"
theme[gpu_text]="#d3c6aa"

# Colors for temp box
theme[temp_box]="#dbbc7f"
theme[temp_text]="#d3c6aa"
theme[temp_start]="#a7c080"
theme[temp_mid]="#dbbc7f"
theme[temp_end]="#e67e80"

# Colors for fan box
theme[fan_box]="#83c092"
theme[fan_text]="#d3c6aa"
theme[fan_speed]="#d3c6aa"
theme[fan_start]="#a7c080"
theme[fan_mid]="#dbbc7f"
theme[fan_end]="#e67e80"

# Gruvbox Dark theme for btop++. Generated by theme-apply --
# edit themes/gruvbox-dark/palette.conf.

# Main background, empty for terminal default
theme[main_bg]="#282828"

# Main text color
theme[main_fg]="#fbf1c7"

# Title color for boxes
theme[title]="#fbf1c7"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#fabd2f"

# Background color of selected item in processes box
theme[selected_bg]="#504945"

# Foreground color of selected item in processes box
theme[selected_fg]="#fbf1c7"

# Color of inactive/disabled text
theme[inactive_fg]="#a89984"

# Colors for cpu box
theme[cpu_box]="#83a598"
theme[cpu_bar]="#83a598"
theme[cpu_text]="#fbf1c7"

# Colors for mem box
theme[mem_box]="#d3869b"
theme[mem_bar]="#d3869b"
theme[mem_text]="#fbf1c7"
theme[mem_cache]="#504945"

# Colors for net box
theme[net_box]="#8ec07c"
theme[net_text]="#fbf1c7"
theme[net_up]="#b8bb26"
theme[net_down]="#83a598"

# Colors for processes box
theme[proc_box]="#8ec07c"
theme[proc_misc]="#a89984"
theme[proc_bar]="#83a598"
theme[proc_bar_bg]="#3c3836"
theme[proc_text]="#fbf1c7"

# Colors for gpu box
theme[gpu_box]="#d3869b"
theme[gpu_text]="#fbf1c7"

# Colors for temp box
theme[temp_box]="#fabd2f"
theme[temp_text]="#fbf1c7"
theme[temp_start]="#b8bb26"
theme[temp_mid]="#fabd2f"
theme[temp_end]="#fb4934"

# Colors for fan box
theme[fan_box]="#8ec07c"
theme[fan_text]="#fbf1c7"
theme[fan_speed]="#fbf1c7"
theme[fan_start]="#b8bb26"
theme[fan_mid]="#fabd2f"
theme[fan_end]="#fb4934"

# Greyscale theme for btop++. Generated by theme-apply --
# edit themes/greyscale/palette.conf.

# Main background, empty for terminal default
theme[main_bg]="#0a0a0a"

# Main text color
theme[main_fg]="#f0f0f0"

# Title color for boxes
theme[title]="#f0f0f0"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#f0f0f0"

# Background color of selected item in processes box
theme[selected_bg]="#222222"

# Foreground color of selected item in processes box
theme[selected_fg]="#f0f0f0"

# Color of inactive/disabled text
theme[inactive_fg]="#8a8a8a"

# Colors for cpu box
theme[cpu_box]="#949494"
theme[cpu_bar]="#949494"
theme[cpu_text]="#f0f0f0"

# Colors for mem box
theme[mem_box]="#e0e0e0"
theme[mem_bar]="#e0e0e0"
theme[mem_text]="#f0f0f0"
theme[mem_cache]="#222222"

# Colors for net box
theme[net_box]="#a0a0a0"
theme[net_text]="#f0f0f0"
theme[net_up]="#acacac"
theme[net_down]="#949494"

# Colors for processes box
theme[proc_box]="#a0a0a0"
theme[proc_misc]="#8a8a8a"
theme[proc_bar]="#949494"
theme[proc_bar_bg]="#1a1a1a"
theme[proc_text]="#f0f0f0"

# Colors for gpu box
theme[gpu_box]="#e0e0e0"
theme[gpu_text]="#f0f0f0"

# Colors for temp box
theme[temp_box]="#b8b8b8"
theme[temp_text]="#f0f0f0"
theme[temp_start]="#acacac"
theme[temp_mid]="#b8b8b8"
theme[temp_end]="#ffffff"

# Colors for fan box
theme[fan_box]="#a0a0a0"
theme[fan_text]="#f0f0f0"
theme[fan_speed]="#f0f0f0"
theme[fan_start]="#acacac"
theme[fan_mid]="#b8b8b8"
theme[fan_end]="#ffffff"

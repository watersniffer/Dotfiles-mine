# Nord Dark theme for btop++. Generated by theme-apply --
# edit themes/nord-dark/palette.conf.

# Main background, empty for terminal default
theme[main_bg]="#2e3440"

# Main text color
theme[main_fg]="#eceff4"

# Title color for boxes
theme[title]="#eceff4"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#88c0d0"

# Background color of selected item in processes box
theme[selected_bg]="#434c5e"

# Foreground color of selected item in processes box
theme[selected_fg]="#eceff4"

# Color of inactive/disabled text
theme[inactive_fg]="#616e88"

# Colors for cpu box
theme[cpu_box]="#88c0d0"
theme[cpu_bar]="#88c0d0"
theme[cpu_text]="#eceff4"

# Colors for mem box
theme[mem_box]="#b48ead"
theme[mem_bar]="#b48ead"
theme[mem_text]="#eceff4"
theme[mem_cache]="#434c5e"

# Colors for net box
theme[net_box]="#8fbcbb"
theme[net_text]="#eceff4"
theme[net_up]="#a3be8c"
theme[net_down]="#88c0d0"

# Colors for processes box
theme[proc_box]="#8fbcbb"
theme[proc_misc]="#616e88"
theme[proc_bar]="#88c0d0"
theme[proc_bar_bg]="#3b4252"
theme[proc_text]="#eceff4"

# Colors for gpu box
theme[gpu_box]="#b48ead"
theme[gpu_text]="#eceff4"

# Colors for temp box
theme[temp_box]="#ebcb8b"
theme[temp_text]="#eceff4"
theme[temp_start]="#a3be8c"
theme[temp_mid]="#ebcb8b"
theme[temp_end]="#bf616a"

# Colors for fan box
theme[fan_box]="#8fbcbb"
theme[fan_text]="#eceff4"
theme[fan_speed]="#eceff4"
theme[fan_start]="#a3be8c"
theme[fan_mid]="#ebcb8b"
theme[fan_end]="#bf616a"

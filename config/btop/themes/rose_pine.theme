# Rosé Pine theme for btop++. Generated by theme-apply --
# edit themes/rose-pine/palette.conf.

# Main background, empty for terminal default
theme[main_bg]="#191724"

# Main text color
theme[main_fg]="#e0def4"

# Title color for boxes
theme[title]="#e0def4"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#c4a7e7"

# Background color of selected item in processes box
theme[selected_bg]="#302d41"

# Foreground color of selected item in processes box
theme[selected_fg]="#e0def4"

# Color of inactive/disabled text
theme[inactive_fg]="#565469"

# Colors for cpu box
theme[cpu_box]="#31748f"
theme[cpu_bar]="#31748f"
theme[cpu_text]="#e0def4"

# Colors for mem box
theme[mem_box]="#c4a7e7"
theme[mem_bar]="#c4a7e7"
theme[mem_text]="#e0def4"
theme[mem_cache]="#302d41"

# Colors for net box
theme[net_box]="#31748f"
theme[net_text]="#e0def4"
theme[net_up]="#9ccfd8"
theme[net_down]="#31748f"

# Colors for processes box
theme[proc_box]="#31748f"
theme[proc_misc]="#565469"
theme[proc_bar]="#31748f"
theme[proc_bar_bg]="#26233a"
theme[proc_text]="#e0def4"

# Colors for gpu box
theme[gpu_box]="#c4a7e7"
theme[gpu_text]="#e0def4"

# Colors for temp box
theme[temp_box]="#f6c177"
theme[temp_text]="#e0def4"
theme[temp_start]="#9ccfd8"
theme[temp_mid]="#f6c177"
theme[temp_end]="#eb6f92"

# Colors for fan box
theme[fan_box]="#31748f"
theme[fan_text]="#e0def4"
theme[fan_speed]="#e0def4"
theme[fan_start]="#9ccfd8"
theme[fan_mid]="#f6c177"
theme[fan_end]="#eb6f92"

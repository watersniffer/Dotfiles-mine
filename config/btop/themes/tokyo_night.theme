# Tokyo Night theme for btop++. Generated by theme-apply --
# edit themes/tokyo-night/palette.conf.

# Main background, empty for terminal default
theme[main_bg]="#1a1b26"

# Main text color
theme[main_fg]="#c0caf5"

# Title color for boxes
theme[title]="#c0caf5"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#7aa2f7"

# Background color of selected item in processes box
theme[selected_bg]="#292e42"

# Foreground color of selected item in processes box
theme[selected_fg]="#c0caf5"

# Color of inactive/disabled text
theme[inactive_fg]="#3b4261"

# Colors for cpu box
theme[cpu_box]="#7aa2f7"
theme[cpu_bar]="#7aa2f7"
theme[cpu_text]="#c0caf5"

# Colors for mem box
theme[mem_box]="#bb9af7"
theme[mem_bar]="#bb9af7"
theme[mem_text]="#c0caf5"
theme[mem_cache]="#292e42"

# Colors for net box
theme[net_box]="#7dcfff"
theme[net_text]="#c0caf5"
theme[net_up]="#9ece6a"
theme[net_down]="#7aa2f7"

# Colors for processes box
theme[proc_box]="#7dcfff"
theme[proc_misc]="#3b4261"
theme[proc_bar]="#7aa2f7"
theme[proc_bar_bg]="#1f2335"
theme[proc_text]="#c0caf5"

# Colors for gpu box
theme[gpu_box]="#bb9af7"
theme[gpu_text]="#c0caf5"

# Colors for temp box
theme[temp_box]="#e0af68"
theme[temp_text]="#c0caf5"
theme[temp_start]="#9ece6a"
theme[temp_mid]="#e0af68"
theme[temp_end]="#f7768e"

# Colors for fan box
theme[fan_box]="#7dcfff"
theme[fan_text]="#c0caf5"
theme[fan_speed]="#c0caf5"
theme[fan_start]="#9ece6a"
theme[fan_mid]="#e0af68"
theme[fan_end]="#f7768e"

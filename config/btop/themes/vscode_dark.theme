# VS Code Dark Modern theme for btop++. Generated by theme-apply --
# edit themes/vscode-dark-modern/palette.conf.

# Main background, empty for terminal default
theme[main_bg]="#1f1f1f"

# Main text color
theme[main_fg]="#cccccc"

# Title color for boxes
theme[title]="#cccccc"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#0078d4"

# Background color of selected item in processes box
theme[selected_bg]="#313131"

# Foreground color of selected item in processes box
theme[selected_fg]="#cccccc"

# Color of inactive/disabled text
theme[inactive_fg]="#767676"

# Colors for cpu box
theme[cpu_box]="#569cd6"
theme[cpu_bar]="#569cd6"
theme[cpu_text]="#cccccc"

# Colors for mem box
theme[mem_box]="#c586c0"
theme[mem_bar]="#c586c0"
theme[mem_text]="#cccccc"
theme[mem_cache]="#313131"

# Colors for net box
theme[net_box]="#4ec9b0"
theme[net_text]="#cccccc"
theme[net_up]="#6a9955"
theme[net_down]="#569cd6"

# Colors for processes box
theme[proc_box]="#4ec9b0"
theme[proc_misc]="#767676"
theme[proc_bar]="#569cd6"
theme[proc_bar_bg]="#202020"
theme[proc_text]="#cccccc"

# Colors for gpu box
theme[gpu_box]="#c586c0"
theme[gpu_text]="#cccccc"

# Colors for temp box
theme[temp_box]="#dcdcaa"
theme[temp_text]="#cccccc"
theme[temp_start]="#6a9955"
theme[temp_mid]="#dcdcaa"
theme[temp_end]="#f44747"

# Colors for fan box
theme[fan_box]="#4ec9b0"
theme[fan_text]="#cccccc"
theme[fan_speed]="#cccccc"
theme[fan_start]="#6a9955"
theme[fan_mid]="#dcdcaa"
theme[fan_end]="#f44747"

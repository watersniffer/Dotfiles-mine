{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "source": "arch",
    "color": {
      "1": "#cba6f7",
      "2": "#f38ba8",
      "3": "#fab387",
      "4": "#f9e2af",
      "5": "#a6e3a1",
      "6": "#94e2d5",
      "7": "#89dceb",
      "8": "#89b4fa"
    },
    "padding": {
      "top": 2,
      "right": 6,
      "left": 2
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "keyWidth": 10,
      "color": "#cdd6f4"
    },
    "break",
    {
      "type": "os",
      "key": " ",
      "keyColor": "#89b4fa",
      "color": "#cdd6f4"
    },
    {
      "type": "host",
      "key": " ",
      "keyColor": "#89b4fa",
      "color": "#cdd6f4"
    },
    {
      "type": "shell",
      "key": " ",
      "keyColor": "#89b4fa",
      "color": "#cdd6f4"
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "#89b4fa",
      "color": "#cdd6f4"
    },
    {
      "type": "wm",
      "format": "{} (wayland)",
      "key": " ",
      "keyColor": "#89b4fa",
      "color": "#cdd6f4"
    },
    {
      "type": "cpu",
      "key": " ",
      "keyColor": "#89b4fa",
      "color": "#cdd6f4"
    },
    {
      "type": "gpu",
      "key": " ",
      "keyColor": "#89b4fa",
      "color": "#cdd6f4"
    },
    {
      "type": "memory",
      "key": " ",
      "keyColor": "#89b4fa",
      "color": "#cdd6f4",
      "format": "{} {}"
    },
    {
      "type": "disk",
      "key": " ",
      "keyColor": "#89b4fa",
      "color": "#cdd6f4"
    },
    {
      "type": "uptime",
      "key": " ",
      "keyColor": "#89b4fa",
      "color": "#cdd6f4"
    },
    "break",
    "break",
    "break"
  ]
}
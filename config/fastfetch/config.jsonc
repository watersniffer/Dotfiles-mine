{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "source": "arch",
    "color": {
      "1": "#a7c080",
      "2": "#e67e80",
      "3": "#e69875",
      "4": "#dbbc7f",
      "5": "#a7c080",
      "6": "#83c092",
      "7": "#7fbbb3",
      "8": "#d699b6"
    },
    "padding": {
      "top": 2,
      "right": 6,
      "left": 2
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "keyWidth": 10,
      "color": "#d3c6aa"
    },
    "break",
    {
      "type": "os",
      "key": " ",
      "keyColor": "#7fbbb3",
      "color": "#d3c6aa"
    },
    {
      "type": "host",
      "key": " ",
      "keyColor": "#7fbbb3",
      "color": "#d3c6aa"
    },
    {
      "type": "shell",
      "key": " ",
      "keyColor": "#7fbbb3",
      "color": "#d3c6aa"
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "#7fbbb3",
      "color": "#d3c6aa"
    },
    {
      "type": "wm",
      "format": "{} (wayland)",
      "key": " ",
      "keyColor": "#7fbbb3",
      "color": "#d3c6aa"
    },
    {
      "type": "cpu",
      "key": " ",
      "keyColor": "#7fbbb3",
      "color": "#d3c6aa"
    },
    {
      "type": "gpu",
      "key": " ",
      "keyColor": "#7fbbb3",
      "color": "#d3c6aa"
    },
    {
      "type": "memory",
      "key": " ",
      "keyColor": "#7fbbb3",
      "color": "#d3c6aa",
      "format": "{} {}"
    },
    {
      "type": "disk",
      "key": " ",
      "keyColor": "#7fbbb3",
      "color": "#d3c6aa"
    },
    {
      "type": "uptime",
      "key": " ",
      "keyColor": "#7fbbb3",
      "color": "#d3c6aa"
    },
    "break",
    "break",
    "break"
  ]
}
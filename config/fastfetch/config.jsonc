{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "source": "arch",
    "color": {
      "1": "#88c0d0",
      "2": "#bf616a",
      "3": "#d08770",
      "4": "#ebcb8b",
      "5": "#a3be8c",
      "6": "#8fbcbb",
      "7": "#88c0d0",
      "8": "#b48ead"
    },
    "padding": {
      "top": 2,
      "right": 6,
      "left": 2
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "keyWidth": 10,
      "color": "#eceff4"
    },
    "break",
    {
      "type": "os",
      "key": " ",
      "keyColor": "#88c0d0",
      "color": "#eceff4"
    },
    {
      "type": "host",
      "key": " ",
      "keyColor": "#88c0d0",
      "color": "#eceff4"
    },
    {
      "type": "shell",
      "key": " ",
      "keyColor": "#88c0d0",
      "color": "#eceff4"
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "#88c0d0",
      "color": "#eceff4"
    },
    {
      "type": "wm",
      "format": "{} (wayland)",
      "key": " ",
      "keyColor": "#88c0d0",
      "color": "#eceff4"
    },
    {
      "type": "cpu",
      "key": " ",
      "keyColor": "#88c0d0",
      "color": "#eceff4"
    },
    {
      "type": "gpu",
      "key": " ",
      "keyColor": "#88c0d0",
      "color": "#eceff4"
    },
    {
      "type": "memory",
      "key": " ",
      "keyColor": "#88c0d0",
      "color": "#eceff4",
      "format": "{} {}"
    },
    {
      "type": "disk",
      "key": " ",
      "keyColor": "#88c0d0",
      "color": "#eceff4"
    },
    {
      "type": "uptime",
      "key": " ",
      "keyColor": "#88c0d0",
      "color": "#eceff4"
    },
    "break",
    "break",
    "break"
  ]
}
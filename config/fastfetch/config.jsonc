{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "source": "arch",
    "color": {
      "1": "#ffffff"
    },
    "padding": {
      "top": 2,
      "right": 6,
      "left": 2
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "keyWidth": 10,
      "color": "#ffffff"
    },
    "break",
    {
      "type": "os",
      "key": " ",
      "keyColor": "#ffffff",
      "color": "#f0f0f0"
    },
    {
      "type": "host",
      "key": " ",
      "keyColor": "#ffffff",
      "color": "#f0f0f0"
    },
    {
      "type": "shell",
      "key": " ",
      "keyColor": "#ffffff",
      "color": "#f0f0f0"
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "#ffffff",
      "color": "#f0f0f0"
    },
    {
      "type": "wm",
      "format": "{} (wayland)",
      "key": " ",
      "keyColor": "#ffffff",
      "color": "#f0f0f0"
    },
    {
      "type": "cpu",
      "key": " ",
      "keyColor": "#ffffff",
      "color": "#f0f0f0"
    },
    {
      "type": "gpu",
      "key": " ",
      "keyColor": "#ffffff",
      "color": "#f0f0f0"
    },
    {
      "type": "memory",
      "key": " ",
      "keyColor": "#ffffff",
      "color": "#f0f0f0",
      "format": "{} {}"
    },
    {
      "type": "disk",
      "key": " ",
      "keyColor": "#ffffff",
      "color": "#f0f0f0"
    },
    {
      "type": "uptime",
      "key": " ",
      "keyColor": "#ffffff",
      "color": "#f0f0f0"
    },
    "break",
    "break",
    "break"
  ]
}
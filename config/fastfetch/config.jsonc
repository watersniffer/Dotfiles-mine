{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "source": "arch",
    "color": {
      "1": "#fabd2f",
      "2": "#fb4934",
      "3": "#fe8019",
      "4": "#fabd2f",
      "5": "#b8bb26",
      "6": "#8ec07c",
      "7": "#83a598",
      "8": "#d3869b"
    },
    "padding": {
      "top": 2,
      "right": 6,
      "left": 2
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "keyWidth": 10,
      "color": "#fbf1c7"
    },
    "break",
    {
      "type": "os",
      "key": " ",
      "keyColor": "#83a598",
      "color": "#fbf1c7"
    },
    {
      "type": "host",
      "key": " ",
      "keyColor": "#83a598",
      "color": "#fbf1c7"
    },
    {
      "type": "shell",
      "key": " ",
      "keyColor": "#83a598",
      "color": "#fbf1c7"
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "#83a598",
      "color": "#fbf1c7"
    },
    {
      "type": "wm",
      "format": "{} (wayland)",
      "key": " ",
      "keyColor": "#83a598",
      "color": "#fbf1c7"
    },
    {
      "type": "cpu",
      "key": " ",
      "keyColor": "#83a598",
      "color": "#fbf1c7"
    },
    {
      "type": "gpu",
      "key": " ",
      "keyColor": "#83a598",
      "color": "#fbf1c7"
    },
    {
      "type": "memory",
      "key": " ",
      "keyColor": "#83a598",
      "color": "#fbf1c7",
      "format": "{} {}"
    },
    {
      "type": "disk",
      "key": " ",
      "keyColor": "#83a598",
      "color": "#fbf1c7"
    },
    {
      "type": "uptime",
      "key": " ",
      "keyColor": "#83a598",
      "color": "#fbf1c7"
    },
    "break",
    "break",
    "break"
  ]
}
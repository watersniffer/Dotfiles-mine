active_colors={{colors.surface_container_low.default.hex}},{{colors.on_surface.default.hex}},{{colors.surface.default.hex}},{{colors.surface_container.default.hex}},{{colors.surface_container_high.default.hex}},{{colors.on_surface.default.hex}},{{colors.on_surface.default.hex}},{{colors.surface_container.default.hex}},{{colors.on_surface.default.hex}},{{colors.on_primary.default.hex}},{{colors.surface_container_high.default.hex}},{{colors.surface_container_highest.default.hex}},{{colors.surface_container_lowest.default.hex}},{{colors.surface_container.default.hex}},{{colors.primary.default.hex}},{{colors.on_primary.default.hex}},{{colors.primary.default.hex}},{{colors.primary.default.hex}},{{colors.tertiary.default.hex}},{{colors.on_surface_variant.default.hex}},{{colors.outline.default.hex}},{{colors.outline_variant.default.hex}}
inactive_colors={{colors.surface_container_low.default.hex}},{{colors.on_surface_variant.default.hex}},{{colors.surface.default.hex}},{{colors.surface_container.default.hex}},{{colors.surface_container_high.default.hex}},{{colors.on_surface_variant.default.hex}},{{colors.on_surface_variant.default.hex}},{{colors.surface_container.default.hex}},{{colors.on_surface_variant.default.hex}},{{colors.surface_container_highest.default.hex}},{{colors.surface_container_high.default.hex}},{{colors.surface_container_highest.default.hex}},{{colors.surface_container_lowest.default.hex}},{{colors.surface_container.default.hex}},{{colors.primary_container.default.hex}},{{colors.on_primary_container.default.hex}},{{colors.primary_container.default.hex}},{{colors.primary_container.default.hex}},{{colors.tertiary_container.default.hex}},{{colors.outline.default.hex}},{{colors.outline.default.hex}},{{colors.outline_variant.default.hex}}

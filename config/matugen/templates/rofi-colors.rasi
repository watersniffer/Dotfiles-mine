/* Rofi palette — generated by matugen from the current wallpaper.
   Variable names are fixed; the values follow the wallpaper. */
* {
  bg0     : {{colors.surface_container_lowest.default.hex}};
  bg1     : {{colors.surface_container_low.default.hex}};
  bg2     : {{colors.surface_container.default.hex}};
  bg3     : {{colors.surface_container_high.default.hex}};

  fg0     : {{colors.on_surface.default.hex}};
  fg1     : {{colors.on_surface_variant.default.hex}};
  fg2     : {{colors.outline.default.hex}};

  red     : {{colors.error.default.hex}};
  green   : {{colors.primary.default.hex}};
  yellow  : {{colors.tertiary.default.hex}};
  blue    : {{colors.secondary.default.hex}};
  magenta : {{colors.tertiary_container.default.hex}};
  cyan    : {{colors.primary_container.default.hex}};

  accent  : {{colors.primary.default.hex}};
  urgent  : {{colors.error.default.hex}};
}

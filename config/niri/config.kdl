// Niri configuration for the monochrome desktop.
// Shared themes and Waybar styling live in the sibling config directories.

environment {
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    QT_QPA_PLATFORMTHEME "qt6ct"
    QT_STYLE_OVERRIDE "kvantum"
    QT_SCALE_FACTOR "0.92"
    XCURSOR_SIZE "22"
    XCURSOR_THEME "Bibata-Modern-Classic"
    // Anything niri spawns inherits this, not ~/.bashrc: kitty -e runs the
    // command directly rather than through a login shell, so $EDITOR was unset
    // for everything launched from a keybind. yazi is configured to call nvim
    // explicitly, but this is what everything else that reads $EDITOR wants.
    EDITOR "nvim"
    VISUAL "nvim"
    // Pinned so the xdg-terminal-exec wrapper in ~/.local/bin cannot be talked
    // into launching something else by an inherited TERMINAL value.
    TERMINAL "kitty"
    PATH "/home/water/.local/bin:/home/water/.local/share/flatpak/exports/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:/var/lib/flatpak/exports/bin"
}

input {
    keyboard {
        xkb {
            layout "us"
        }
    }

    touchpad {
        tap
        // natural-scroll is deliberately off. It inverts libinput's axes so
        // two-finger scroll runs like a phone, which is the opposite of the
        // wheel. A flag, not a key with a value: "natural-scroll true" is a
        // parse error, same as writing "tap true".
    }

    // Keep the system logind power-button policy instead of letting Niri
    // intercept the power key.
    disable-power-key-handling
    focus-follows-mouse
    workspace-auto-back-and-forth
    mod-key "Super"

    mouse {
    }
    trackpoint
}

// This machine routes the internal panel through the Intel iGPU. Explicitly
// select it so Niri does not fall back to the slower hybrid-GPU path.
debug {
    render-drm-device "/dev/dri/renderD128"
}

// logind already suspends on lid close; lock before the session sleeps.
switch-events {
    lid-close { spawn "sh" "-c" "swaylock -C ~/.config/niri/lock.conf -f"; }
}

output "eDP-1" {
    mode "1366x768@60.016"
    scale 1.0
    position x=0 y=0
}

layout {
    gaps 5
    default-column-width { proportion 0.5; }
    center-focused-column "never"

    focus-ring {
        off

        width 1

        active-color "#a7c080"

        inactive-color "#859289"
    }

    border {
        // No window outlines, and the focus ring above is off too, so nothing
        // frames a window. The shadow below is what separates it from the
        // wallpaper, and the 0.90 opacity is what shows the wallpaper through
        // it.
        //
        // A border on a translucent window draws a frame you can see the
        // background through, which reads as a rendering fault rather than as
        // an edge. That is the combination that made borders look wrong here,
        // so both stay off.
        //
        // Width and colours are kept, and the colours are still THEME-managed,
        // so this is a one-word change if you want them back.
        off

        width 1

        active-color "#a7c080"

        inactive-color "#859289"
    }

    shadow {
        on
        softness 7
        spread 0
        offset x=0 y=3
        color "#2d353b99"
    }

    // Waybar is a layer-shell panel and reserves its own top zone; adding
    // Niri struts here would create a second gap.
}

// Draw rounded, shadowed, translucent clients instead of the server-side
// titlebars.
prefer-no-csd

// No blur. The global blur settings are gone along with the per-window
// background-effect below, because in niri this block only sets the parameters;
// nothing draws a blur until a window rule asks for one.
//
// Why it went: blur was the single most expensive thing in this compositor on an
// HD 520, and it kept looking wrong in ways that were hard to pin down -- a
// bright shape on the wallpaper smeared into a soft blob behind translucent
// windows, which reads as a rendering fault rather than as frosted glass. Every
// pass-count and radius value that was tried (1, 2, 3; offset 8 and 16) had the
// same character. The measurements in the history said the cost difference was
// inside the noise, so the honest read is that it was not earning its keep on
// quality either.
//
// Transparency is unaffected: the 0.90 below and kitty's own background_opacity
// still apply, so windows are still see-through. They are just sharp rather than
// blurred now. If this ever comes back, it is one line -- `blur true` in the
// window rule below, with `passes`/`offset` back in a block here.

window-rule {
    match app-id="^kitty$"
    // 1.0, not a lower number, and deliberately so. Kitty draws its own
    // translucency (background_opacity in its kitty.conf), and this blanket
    // rule's 0.90 would multiply on top of it -- 0.90 x 0.80 is 0.72, so the
    // window ends up more transparent than the number in kitty.conf says and
    // there are two dials for one effect. 1.0 leaves the compositor out of it
    // and kitty's own setting is the single source of truth. The rounding and
    // clipping still come from the blanket rule below, since this one only
    // overrides opacity.
    opacity 1.0
}

window-rule {
    // One blanket rule for every window, rather than the two this used to be.
    // Both of the old ones matched everything and both set a background-effect,
    // so which xray won depended on how niri merged two effects blocks in
    // sequence. Rounded, clipped and 90% opaque is one intent, so it is written
    // once.
    //
    // Rounded corners, kept even with the border off: they soften the window's
    // own edges against the wallpaper, which is doing the separating work now
    // that no border does.
    opacity 0.90
    geometry-corner-radius 10
    clip-to-geometry true
    // No background-effect. Opacity alone still makes the window see-through, so
    // this is the "leave transparency" half: windows are translucent, the
    // backdrop behind them is left sharp. See the note above the removed blur
    // block for why, and for what to add back to restore it.
}

window-rule {
    match app-id=r"^it\.mijorus\.smile$"
    open-floating true
    open-focused false
    default-column-width { fixed 500; }
    default-window-height { fixed 400; }
}

cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 22
}


screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    workspace-switch {
        // Stiffer springs settle in fewer frames. Every animation frame is a
        // full re-render, so fewer frames is both smoother-looking and cheaper
        // on an HD 520. (No blur pass any more -- that was removed.)
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    window-open {
        duration-ms 150
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 120
        curve "ease-out-cubic"
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
}

hotkey-overlay {
    skip-at-startup
    hide-not-bound
}

spawn-at-startup "~/.local/bin/niri-startup"

binds {
    Mod+Return repeat=false { spawn "kitty"; }
    Super+Alt+L repeat=false { spawn-sh "swaylock -C ~/.config/niri/lock.conf -f"; }
    Mod+B repeat=false { spawn "firefox"; }
    Mod+Q repeat=false { close-window; }
    Mod+M repeat=false { quit skip-confirmation=true; }
    Mod+E repeat=false { spawn "kitty" "--class" "yazi" "-e" "yazi"; }
    Mod+D repeat=false { spawn "nemo"; }
    Mod+V repeat=false { toggle-window-floating; }
    Mod+F repeat=false { fullscreen-window; }
    Mod+J hotkey-overlay-title="Consume or Expel Window Right" repeat=false { consume-or-expel-window-right; }

    Mod+Left repeat=false { focus-column-left; }
    Mod+Right repeat=false { focus-column-right; }
    Mod+Up repeat=false { focus-window-up; }
    Mod+Down repeat=false { focus-window-down; }

    // Keyboard window/column movement. Previously there was no keyboard way to
    // move a column or a window at all -- only the mouse wheel could do it.
    Mod+Ctrl+Left repeat=false { move-column-left; }
    Mod+Ctrl+Right repeat=false { move-column-right; }
    Mod+Ctrl+Up repeat=false { move-window-up; }
    Mod+Ctrl+Down repeat=false { move-window-down; }

    Mod+Space repeat=false { spawn "rofi" "-show" "drun"; }
    Mod+Comma repeat=false { spawn "smile"; }
    // Theme picker. themesw re-renders every app's colours from
    // themes/<slug>/palette.conf, then reloads the bar, mako and niri.
    Mod+T repeat=false { spawn-sh "~/.local/bin/themesw"; }
    Mod+C repeat=false { spawn-sh "cliphist list | rofi -dmenu -theme ~/.config/rofi/config.rasi | cliphist decode | wl-copy"; }
    // The wallpaper picker, scoped to the current theme's folder: each theme
    // names its own under themes/<slug>/palette.conf, and a folder that is
    // missing or still empty falls back to ALL.
    Mod+W repeat=false { spawn-sh "~/.local/bin/wallpaper-switcher"; }
    // Every wallpaper, across all folders.
    Mod+Ctrl+W repeat=false { spawn-sh "~/.local/bin/wallpaper-switcher all"; }
    Mod+Shift+W repeat=false { spawn-sh "~/.local/bin/toggle-waybar"; }
    // Cycle the power profile: power-saver -> balanced -> performance.
    Mod+P repeat=false { spawn-sh "~/.local/bin/powerprofile"; }
    // The logout menu moved here when Super+P was given back to the power
    // profiles; it used to be Super+P.
    Mod+U repeat=false { spawn "wlogout"; }

    // Index-free column jumps. Arrow keys already do left/right, so these add
    // first/last only -- no duplicated actions.
    Mod+Home repeat=false { focus-column-first; }
    Mod+End repeat=false { focus-column-last; }
    Mod+Ctrl+Home repeat=false { move-column-to-first; }
    Mod+Ctrl+End repeat=false { move-column-to-last; }

    // Alt+Tab cycles through recent windows, as on any desktop. Niri spells
    // this "focus the previously focused window", so repeated presses walk
    // back through the recent-window history.
    Alt+Tab repeat=false { focus-window-previous; }

    // Page keys for workspace navigation, alongside the existing wheel binds.
    Mod+Page_Up repeat=false { focus-workspace-up; }
    Mod+Page_Down repeat=false { focus-workspace-down; }
    Mod+Ctrl+Page_Up repeat=false { move-column-to-workspace-up; }
    Mod+Ctrl+Page_Down repeat=false { move-column-to-workspace-down; }

    // Workspace switching for the numbered dynamic workspaces.
    Mod+1 repeat=false { focus-workspace 1; }
    Mod+2 repeat=false { focus-workspace 2; }
    Mod+3 repeat=false { focus-workspace 3; }
    Mod+4 repeat=false { focus-workspace 4; }
    Mod+5 repeat=false { focus-workspace 5; }
    Mod+6 repeat=false { focus-workspace 6; }
    Mod+7 repeat=false { focus-workspace 7; }
    Mod+8 repeat=false { focus-workspace 8; }
    Mod+9 repeat=false { focus-workspace 9; }
    Mod+0 repeat=false { focus-workspace 10; }

    Mod+Shift+1 repeat=false { move-window-to-workspace 1; }
    Mod+Shift+2 repeat=false { move-window-to-workspace 2; }
    Mod+Shift+3 repeat=false { move-window-to-workspace 3; }
    Mod+Shift+4 repeat=false { move-window-to-workspace 4; }
    Mod+Shift+5 repeat=false { move-window-to-workspace 5; }
    Mod+Shift+6 repeat=false { move-window-to-workspace 6; }
    Mod+Shift+7 repeat=false { move-window-to-workspace 7; }
    Mod+Shift+8 repeat=false { move-window-to-workspace 8; }
    Mod+Shift+9 repeat=false { move-window-to-workspace 9; }
    Mod+Shift+0 repeat=false { move-window-to-workspace 10; }

    // Niri has no special workspace; overview is the closest equivalent.
    Mod+S hotkey-overlay-title="Open the Overview" repeat=false { toggle-overview; }

    // Touchpad equivalents of the wheel workspace binds, left commented out
    // because natural-scroll is off: with it off, two-finger scroll runs
    // opposite to the wheel, so these would move the wrong way. Re-enable them
    // if you turn natural-scroll back on.
    // Mod+TouchpadScrollDown cooldown-ms=150 { focus-workspace-down; }
    // Mod+TouchpadScrollUp cooldown-ms=150 { focus-workspace-up; }

    Mod+WheelScrollDown repeat=false cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp repeat=false cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+Ctrl+WheelScrollRight cooldown-ms=150 { move-column-right; }
    Mod+Ctrl+WheelScrollLeft cooldown-ms=150 { move-column-left; }

    // Missing Niri defaults: workspace and monitor movement.
    Mod+Shift+Page_Down repeat=false { move-workspace-down; }
    Mod+Shift+Page_Up repeat=false { move-workspace-up; }
    // Monitor focus only does something on a multi-monitor setup; this machine
    // has one output, so these moved off Mod+Shift+Arrow (which now resizes) to
    // the free Mod+Alt+Arrow block. They are harmless when there is one screen.
    Mod+Alt+Left repeat=false { focus-monitor-left; }
    Mod+Alt+Right repeat=false { focus-monitor-right; }
    Mod+Alt+Up repeat=false { focus-monitor-up; }
    Mod+Alt+Down repeat=false { focus-monitor-down; }

    // Resize with Shift+Arrow, matching the rest of the arrow-key navigation.
    Mod+Shift+Left repeat=false { set-column-width "-10%"; }
    Mod+Shift+Right repeat=false { set-column-width "+10%"; }
    Mod+Shift+Up repeat=false { set-window-height "-10%"; }
    Mod+Shift+Down repeat=false { set-window-height "+10%"; }
    Mod+Shift+Ctrl+Left repeat=false { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down repeat=false { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up repeat=false { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right repeat=false { move-column-to-monitor-right; }
    Mod+Ctrl+1 repeat=false { move-column-to-workspace 1; }
    Mod+Ctrl+2 repeat=false { move-column-to-workspace 2; }
    Mod+Ctrl+3 repeat=false { move-column-to-workspace 3; }
    Mod+Ctrl+4 repeat=false { move-column-to-workspace 4; }
    Mod+Ctrl+5 repeat=false { move-column-to-workspace 5; }
    Mod+Ctrl+6 repeat=false { move-column-to-workspace 6; }
    Mod+Ctrl+7 repeat=false { move-column-to-workspace 7; }
    Mod+Ctrl+8 repeat=false { move-column-to-workspace 8; }
    Mod+Ctrl+9 repeat=false { move-column-to-workspace 9; }
    Mod+Ctrl+0 repeat=false { move-column-to-workspace 10; }

    // Missing Niri defaults: column/window manipulation.
    Mod+BracketLeft repeat=false { consume-or-expel-window-left; }
    Mod+Period repeat=false { expel-window-from-column; }
    Mod+R repeat=false { switch-preset-column-width; }
    Mod+Shift+R repeat=false { switch-preset-column-width-back; }
    Mod+Ctrl+Shift+R repeat=false { switch-preset-window-height; }
    Mod+Ctrl+R repeat=false { reset-window-height; }
    Mod+Ctrl+F repeat=false { expand-column-to-available-width; }
    Mod+Ctrl+C repeat=false { center-visible-columns; }
    Mod+Minus repeat=false { set-column-width "-10%"; }
    Mod+Equal repeat=false { set-column-width "+10%"; }
    Mod+Shift+Minus repeat=false { set-window-height "-10%"; }
    Mod+Shift+Equal repeat=false { set-window-height "+10%"; }
    Mod+Shift+V repeat=false { switch-focus-between-floating-and-tiling; }

    // Missing Niri default: monitor power.
    Mod+Shift+P repeat=false { power-off-monitors; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute allow-when-locked=true repeat=false { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute allow-when-locked=true repeat=false { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    // Wrapped rather than calling brightnessctl directly, because brightness 0%
    // is not a dark screen on this panel -- the backlight goes off but the LCD
    // stays lit. brightness-step treats 0% as the trigger for niri's
    // power-off-monitors, so the bottom of the range is genuinely black, and the
    // same key brings the monitor back.
    XF86MonBrightnessUp allow-when-locked=true { spawn "~/.local/bin/brightness-step" "up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "~/.local/bin/brightness-step" "down"; }
    XF86AudioNext allow-when-locked=true repeat=false { spawn "playerctl" "next"; }
    XF86AudioPause allow-when-locked=true repeat=false { spawn "playerctl" "play-pause"; }
    XF86AudioPlay allow-when-locked=true repeat=false { spawn "playerctl" "play-pause"; }
    XF86AudioPrev allow-when-locked=true repeat=false { spawn "playerctl" "previous"; }
    XF86AudioStop allow-when-locked=true repeat=false { spawn "playerctl" "stop"; }

    Print repeat=false { screenshot; }
    Ctrl+Print repeat=false { screenshot-screen; }
    Alt+Print repeat=false { screenshot-window; }
    Mod+Shift+Slash repeat=false { show-hotkey-overlay; }
    Mod+Escape repeat=false { toggle-keyboard-shortcuts-inhibit; }
}

gestures {
    hot-corners {
        top-left
    }
}

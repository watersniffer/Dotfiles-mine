configuration {
    show-icons: false;
    lines: 5;
}

window {
    background-color: #101418;
    border-color: #a0cafd;
    border: 2px;
    border-radius: 8px;
    width: 240px;
    padding: 12px;
}

mainbox {
    background-color: transparent;
    children: [ listview ];
}

listview {
    background-color: transparent;
    spacing:          2px;
    fixed-height:     false;
    scrollbar:        false;
    lines:            5;
    fixed-columns:    true;
}

element {
    background-color: transparent;
    text-color: #e1e2e8;
    padding: 8px 16px;
    border-radius: 4px;
}

element selected.normal {
    background-color: #1d2024;
    text-color: #e1e2e8;
}

element-text {
    background-color: transparent;
    text-color: #e1e2e8;
    expand: true;
    vertical-align: 0.5;
}
configuration {
    show-icons: false;
    lines: 5;
}

window {
    background-color: #161616;
    border-color: #ffffff;
    border: 2px;
    border-radius: 8px;
    width: 240px;
    padding: 12px;
}

mainbox {
    background-color: transparent;
    children: [ listview ];
}

listview {
    background-color: transparent;
    spacing:          2px;
    fixed-height:     false;
    scrollbar:        false;
    lines:            5;
    fixed-columns:    true;
}

element {
    background-color: transparent;
    text-color: #f0f0f0;
    padding: 8px 16px;
    border-radius: 4px;
}

element selected.normal {
    background-color: #1e1e1e;
    text-color: #f0f0f0;
}
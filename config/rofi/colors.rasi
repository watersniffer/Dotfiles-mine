/* Rofi palette — generated by matugen from the current wallpaper.
   Variable names are fixed; the values follow the wallpaper. */
* {
  bg0     : #110c16;
  bg1     : #1e1a24;
  bg2     : #231e28;
  bg3     : #2d2833;

  fg0     : #e9dfee;
  fg1     : #cdc3d1;
  fg2     : #968e9b;

  red     : #ffb4ab;
  green   : #d9b9ff;
  yellow  : #ebb6e4;
  blue    : #dabde2;
  magenta : #61395f;
  cyan    : #6400ba;

  accent  : #d9b9ff;
  urgent  : #ffb4ab;
}

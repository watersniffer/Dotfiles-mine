/* Greyscale. The theme engine that used to generate this is gone with the rice
 * switch, so these are written by hand now.
 *
 * They match themes/greyscale/palette.conf, which is what config/waybar/colors.css
 * is generated from. If you change the palette, change these too -- nothing
 * rewrites this file automatically any more.
 *
 * Pure greys: the rice this came from called itself monochrome but shipped grey
 * with a purple accent, and that purple was replaced here so nothing on screen
 * reintroduces colour the palette does not have.
 */

* {
    bg0:     #0a0a0a;
    bg1:     #121212;
    bg2:     #1a1a1a;
    bg3:     #222222;
    fg0:     #f0f0f0;
    fg1:     #d4d4d4;
    fg2:     #b0b0b0;
    red:     #d0d0d0;
    green:   #acacac;
    yellow:  #b8b8b8;
    blue:    #949494;
    magenta: #e0e0e0;
    cyan:    #a0a0a0;
    orange:  #c4c4c4;
    accent:  #f0f0f0;
    urgent:  #ffffff;
}

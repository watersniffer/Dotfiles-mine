/* Rofi palette — generated by matugen from the current wallpaper.
   Variable names are fixed; the values follow the wallpaper. */
* {
  bg0     : #090e17;
  bg1     : #171c24;
  bg2     : #1b2029;
  bg3     : #252a33;

  fg0     : #dee2ef;
  fg1     : #c2c6d2;
  fg2     : #8c919c;

  red     : #ffb4ab;
  green   : #a5c8ff;
  yellow  : #c5c0f9;
  blue    : #bdc5eb;
  magenta : #454171;
  cyan    : #004786;

  accent  : #a5c8ff;
  urgent  : #ffb4ab;
}

/* E-ink. Generated by theme-apply -- edit themes/e-ink/palette.conf.
 *
 * config.rasi references these and nothing else, so it never has to be
 * rewritten when the theme changes.
 *
 * The last six are not plain roles: the three surface colours carry alpha so
 * the window is translucent and the desktop shows through, and the rounded
 * corners only read because config.rasi keeps every inner container
 * transparent. selectedBg and onSelected are opaque, so a selected row still
 * reads over the translucency.
 *
 * The alpha values were 0.72 and 0.82, which was tuned when the blur was
 * strong enough to dissolve whatever was behind the panel. It is not: niri
 * 26.04's blur here is weak no matter what it is set to (see the blur block in
 * config/niri/config.kdl -- passes 2 and 3 are pixel-identical, and offset 8
 * and 16 differ by 326 pixels), so at 0.72 the backdrop stopped being a frosted
 * suggestion and became a smudge that competed with the menu text. Raising the
 * panel opacity is what actually makes it legible; 0.86 keeps the desktop
 * visible at the edges while the list itself stays readable over anything.
 * Lower these two together if you want more show-through. */
* {
    bg0     : #0d0d0d;
    bg1     : #000000;
    bg2     : #1a1a1a;
    bg3     : #262626;

    fg0     : #f2f2f2;
    fg1     : #d0d0d0;
    fg2     : #a0a0a0;

    red     : #dcdcdc;
    green   : #bdbdbd;
    yellow  : #c8c8c8;
    blue    : #a8a8a8;
    magenta : #e0e0e0;
    cyan    : #b2b2b2;
    orange  : #d2d2d2;

    accent  : #f2f2f2;
    urgent  : #ffffff;

    windowBg  : rgba(0 0 0 / 0.86);
    surfaceBg : rgba(13 13 13 / 0.93);
    borderSoft : rgba(38 38 38 / 0.80);
    selectedBg : #262626;
    onSelected : #f2f2f2;
    onUrgent   : #0d0d0d;
}

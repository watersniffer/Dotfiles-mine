/* Catppuccin Mocha. Generated by theme-apply -- edit themes/catppuccin-mocha/palette.conf.
 *
 * config.rasi references these and nothing else, so it never has to be
 * rewritten when the theme changes.
 *
 * The last six are not plain roles: the three surface colours carry alpha so
 * the window is translucent and the desktop shows through, and the rounded
 * corners only read because config.rasi keeps every inner container
 * transparent. selectedBg and onSelected are opaque, so a selected row still
 * reads over the translucency. */
* {
    bg0     : #1e1e2e;
    bg1     : #181825;
    bg2     : #313244;
    bg3     : #45475a;

    fg0     : #cdd6f4;
    fg1     : #bac2de;
    fg2     : #7f849c;

    red     : #f38ba8;
    green   : #a6e3a1;
    yellow  : #f9e2af;
    blue    : #89b4fa;
    magenta : #cba6f7;
    cyan    : #94e2d5;
    orange  : #fab387;

    accent  : #cba6f7;
    urgent  : #f38ba8;

    windowBg  : rgba(24 24 37 / 0.72);
    surfaceBg : rgba(30 30 46 / 0.82);
    borderSoft : rgba(69 71 90 / 0.80);
    selectedBg : #45475a;
    onSelected : #cdd6f4;
    onUrgent   : #1e1e2e;
}

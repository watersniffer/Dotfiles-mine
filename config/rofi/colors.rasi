/* Catppuccin Mocha. Static palette -- the wallpaper does not drive it. */
* {
    bg0     : #1e1e2e;  /* base */
    bg1     : #181825;  /* mantle */
    bg2     : #313244;  /* surface0 */
    bg3     : #45475a;  /* surface1 */

    fg0     : #cdd6f4;  /* text */
    fg1     : #bac2de;  /* subtext1 */
    fg2     : #7f849c;  /* overlay1 */

    red     : #f38ba8;
    green   : #a6e3a1;
    yellow  : #f9e2af;
    blue    : #89b4fa;
    magenta : #cba6f7;  /* mauve */
    cyan    : #94e2d5;  /* teal */

    accent  : #cba6f7;
    urgent  : #f38ba8;
}

/* Rofi palette — generated by matugen from the current wallpaper.
   Variable names are fixed; the values follow the wallpaper. */
* {
  bg0     : #090e16;
  bg1     : #161c24;
  bg2     : #1a2028;
  bg3     : #252a33;

  fg0     : #dee2ee;
  fg1     : #c2c6d2;
  fg2     : #8c919c;

  red     : #ffb4ab;
  green   : #a4c9ff;
  yellow  : #c4c1f9;
  blue    : #bcc5eb;
  magenta : #434171;
  cyan    : #004883;

  accent  : #a4c9ff;
  urgent  : #ffb4ab;
}

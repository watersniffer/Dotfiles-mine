configuration {
    modes: "drun";
    sorting-method: "normal";
    show-icons: true;
    icon-theme: "Papirus";
    matching: "regex";
    drun-match-fields: "name";
    display-run: "menu:";
    display-drun: "Launch:";
}

@theme "tokyo"

@import "colors.rasi"

* {
    font: "JetBrainsMono Nerd Font 10";
    background-color: transparent;
    text-color: @fg0;

    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

/* ===== Window ===== */
window {
    location: center;
    width: 500;
    y-offset: -20;

    /* The rounded corners only show because every container inside is
       transparent and the window itself is the translucent one. */
    border-radius: 10px;
    border: 2px;
    border-color: @bg3;

    background-color: @windowBg;
}

/* ===== Main container ===== */
mainbox {
    padding: 0px;
    background-color: transparent;
}

/* ===== Input bar ===== */
inputbar {
    background-color: @surfaceBg;
    border-radius: 8px;
    border: 1px;
    border-color: @borderSoft;

    padding: 8px 16px;
    spacing: 8px;
}

prompt {
    text-color: @cyan;
    background-color: transparent;
}

entry {
    text-color: @fg0;
    placeholder: "search";
    placeholder-color: @cyan;
    background-color: transparent;
}

/* ===== List ===== */
listview {
    background-color: transparent;
    margin: 10px 0 0;

    columns: 1;
    lines: 6;
    fixed-height: false;
}

/* ===== Elements ===== */
element {
    padding: 10px 6px;
    spacing: 6px;
    border-radius: 8px;

    background-color: transparent;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg0;
}

element normal.active,
element alternate.active {
    background-color: @surfaceBg;
    text-color: @fg0;
}

element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color: @urgent;
}

element selected.normal,
element selected.active {
    background-color: @selectedBg;
    text-color: @onSelected;
}

element selected.urgent {
    background-color: @urgent;
    text-color: @onUrgent;
}

/* ===== Icons & text ===== */
element-icon {
    size: 1em;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
    background-color: transparent;
}

/* ===== Message box ===== */
message {
    margin: 12px 0 0;
    border-radius: 10px;
    border: 1px;
    border-color: @borderSoft;

    background-color: @surfaceBg;
}

textbox {
    padding: 8px 24px;
    background-color: @surfaceBg;
}
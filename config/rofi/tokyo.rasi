* {
  bg0     : #0d0d0d;
  bg1     : #111111;
  bg2     : #151515;
  bg3     : #1c1c1c;

  fg0     : #f0f0f0;
  fg1     : #cccccc;
  fg2     : #a0a0a0;

  red     : #ff5555;
  green   : #a6a6a6;
  yellow  : #cfcfcf;
  blue    : #e0e0e0;   /* light gray */
  magenta : #dddddd;
  cyan    : #e8e8e8;

  accent  : #ffffff;
  urgent  : #ff5555;
}
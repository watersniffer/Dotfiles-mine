# Sway session matching the monochrome Hyprland setup.
# The SDDM entry for this session is installed as "Sway (Dotfiles)".

### Variables
set $mod Mod4
set $term kitty

### Appearance and layout
# The Hyprland GUI override is the effective source: 5px gaps, no border,
# opaque windows, and a 24px Bibata cursor. Stock Sway cannot reproduce
# Hyprland's blur, shadow, rounded-corner, or animation effects.
gaps inner 5
gaps outer 5
default_border none
default_floating_border none
titlebar_border_thickness 0
titlebar_padding 0 0
workspace_layout default
output eDP-1 allow_tearing no
output * allow_tearing no
focus_follows_mouse yes
focus_on_window_activation smart
floating_modifier $mod normal

# These colors match the monochrome Hyprland border colors. They are normally
# invisible because the border/titlebar thickness is zero.
client.focused #f0f0f0 #f0f0f0 #f0f0f0
client.focused_inactive #2b2b2b #2b2b2b #2b2b2b
client.unfocused #2b2b2b #2b2b2b #2b2b2b
client.urgent #dddddd #dddddd #dddddd

### Output
# This is the laptop panel used by the current Hyprland setup. Sway will use
# the panel's advertised default mode when it starts.
output eDP-1 resolution 1366x768 position 0 0 scale 1
output * bg #000000 solid_color

### Input
input type:keyboard xkb_layout us
input type:touchpad natural_scroll disabled

# Keep X11 applications working as they do in the Hyprland session.
xwayland enable

### Application rules
no_focus [app_id="it.mijorus.smile"]
no_focus [class="it.mijorus.smile"]
for_window [app_id="it.mijorus.smile"] floating enable, resize set 500 400, move position center
for_window [class="it.mijorus.smile"] floating enable, resize set 500 400, move position center

### Session startup
include /etc/sway/config.d/*
exec ~/.local/bin/sway-startup

### Key bindings
bindsym $mod+Return exec $term
bindsym $mod+b exec helium-browser
bindsym $mod+q kill
bindsym $mod+m exec "swaymsg exit"
bindsym $mod+e exec "kitty --class yazi -e yazi"
bindsym $mod+d exec nemo
bindsym $mod+v floating toggle
bindsym $mod+f fullscreen toggle
bindsym $mod+j layout toggle split
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down
bindsym $mod+space exec rofi -show drun
bindsym $mod+comma exec smile
bindsym $mod+c exec "cliphist list | rofi -dmenu -theme ~/.config/rofi/config.rasi | cliphist decode | wl-copy"
bindsym $mod+w exec matuwall
bindsym $mod+Shift+w exec ~/.local/bin/toggle-waybar
bindsym $mod+p exec wlogout

# Switch workspaces with Super+1..0 and move windows with Super+Shift+1..0.
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Hyprland's special:magic workspace, hidden from the Sway Waybar.
bindsym $mod+s exec ~/.local/bin/sway-special-workspace toggle
bindsym $mod+Shift+s exec ~/.local/bin/sway-special-workspace move

# Three-finger horizontal workspace gesture, matching Hyprland.
bindgesture swipe:right workspace prev
bindgesture swipe:left workspace next

# Mouse workspace navigation and window movement.
bindsym $mod+Button4 workspace prev
bindsym $mod+Button5 workspace next
bindsym --whole-window $mod+button1 move
bindsym --whole-window $mod+button3 resize

# Laptop multimedia keys.
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86MonBrightnessUp exec brightnessctl -e4 -n2 set 5%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl -e4 -n2 set 5%-
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPrev exec playerctl previous
bindsym --locked XF86AudioStop exec playerctl stop

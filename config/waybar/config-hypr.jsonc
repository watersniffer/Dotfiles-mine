// Zeibytes/most-racist-rice waybar config, adapted rather than copied as-is.
//
// Four changes from upstream, all of them things that would simply not work here:
//
//   custom/cpucat exec   upstream hardcodes /home/zei/...; rewritten to this
//                        machine's ~/.config/waybar/scripts/catloop.sh
//   modules-right        "tray" was missing upstream, so no tray icons at all
//   mpris "player"       pinned to spotify upstream, which is not installed --
//                        that pin is why media never appears, so it is removed
//                        and any MPRIS player is accepted
//   trailing commas      stripped, since JSONC-with-commas will not parse as JSON
//
// Colours are NOT here: style.css @imports colors.css, which theme-apply
// generates from themes/<slug>/palette.conf. That is why switching theme with
// Super+T still restyles this bar.
// height is 34, not 30: waybar's hyprland/workspaces module has a
// hard 34px minimum that no font-size or padding change gets under.
// Measured with a stripped-down config: an empty modules-right and a clock-only
// one both honour height 30; adding hyprland/workspaces puts the floor at 34
// regardless. Asking for 30 just logs a warning and is ignored, so it asks for 34.
{
  "layer": "top",
  "position": "top",
  "spacing": 2,
  "height": 34,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "tray",
    "wireplumber",
    "backlight",
    "battery",
    "clock",
    "custom/power"
  ],
  "custom/tab": {
    "format": "[Z]",
    "on-click": "rofi -show drun"
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-number": true
  },
  "mpris": {
    "format": "  {artist} - {title} ",
    "format-paused": " \udb81\udc0a {artist} - {title} ",
    "max-length": 37,
    "tooltip": true
  },
  "tray": {
    "icon-size": 16,
    "spacing": 6
  },
  "wireplumber": {
    "scroll-step": 5,
    "format": " {icon} {volume}%",
    "format-muted": "\udb81\udf5f muted",
    "on-click": "pavucontrol",
    "format-icons": {
      "default": [
        "\udb81\udd7f",
        "\udb81\udd80",
        "\udb81\udd7e"
      ],
      "headphones": "\udb80\udecb",
      "headset": "\udb80\udece"
    }
  },
  "backlight": {
    "device": "intel_backlight",
    "format": " {icon} {percent}% ",
    "format-icons": [
      "\udb80\udcde",
      "\udb80\udcdf",
      "\udb80\udce0"
    ]
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}% ",
    "format-charging": "\udb80\udc84 {capacity}% ",
    "format-plugged": "\udb85\udfe6 {capacity}% ",
    "format-full": "\udb80\udc79 {capacity}% ",
    "format-icons": [
      "\udb80\udc8e",
      "\udb80\udc7a",
      "\udb80\udc7b",
      "\udb80\udc7c",
      "\udb80\udc7d",
      "\udb80\udc7e",
      "\udb80\udc7f",
      "\udb80\udc80",
      "\udb80\udc81",
      "\udb80\udc82",
      "\udb80\udc79"
    ]
  },
  "clock": {
    "format": "{:%m-%d-%Y %H:%M} "
  },
  "custom/power": {
    "format": "\u23fb",
    "on-click": "wlogout",
    "tooltip": true
  },
  "modules-center": [
    "mpris"
  ]
}

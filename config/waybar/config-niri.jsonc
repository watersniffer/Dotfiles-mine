{
  // Pick up colours.css changes (matugen-theme rewrites it on every
  // wallpaper change) without a restart, so the bar never blinks out.
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 5,
  // Attached to the top edge: no floating margins, and a real 34px height
  // (it used to be 1 here, with the visible height coming from the CSS
  // min-height instead).
  "height": 30,

  "modules-left": ["niri/workspaces", "custom/cpucat"],
  "modules-center": ["mpris"],
  "modules-right": [
    "tray",
    "wireplumber",
    "backlight",
    "battery",
    "clock"
  ],
  "niri/workspaces": {
    "format": "{value}"
  },

  "mpris": {
    "format": "  {artist} - {title} ",
    "format-paused": " 󰐊 {artist} - {title} ",
    "max-length": 37,
    "tooltip": true
  },

  "tray": {
    "icon-size": 14,
    "spacing": 4
  },
  "custom/cpucat": {
    "exec": "bash ~/.config/waybar/scripts/catloop.sh"
  },
  "wireplumber": {
    "scroll-step": 5,
    "format": " {icon} {volume}%",
    "format-muted": "󰝟 muted",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"],
      "headphones": "󰋋",
      "headset": "󰋎"
    }
  },

  "backlight": {
    "on-click": "~/.local/bin/toggle-night-light",
    "format": " {icon} {percent}% ",
    "format-icons": ["󰃞", "󰃟", "󰃠"]
  },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon} {capacity}% ",
    "format-charging": "󰂄 {capacity}% ",
    "format-plugged": "󱟦 {capacity}% ",
    "format-full": "󰁹 {capacity}% ",
    "format-icons": [
      "󰂎", "󰁺", "󰁻", "󰁼", "󰁽",
      "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"
    ]
  },

  "clock": {
    "format": "{:%m-%d-%Y %I:%M %p}"
  }
}

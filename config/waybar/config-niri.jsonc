{
  // Reload the stylesheet in place when colours.css changes, so editing the
  // palette never makes the bar blink out and come back.
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 5,
  // Attached to the top edge: no floating margins, and a real 34px height
  // (it used to be 1 here, with the visible height coming from the CSS
  // min-height instead).
  "height": 35,

  "modules-left": ["niri/workspaces", "custom/cpucat"],
  // custom/media rather than mpris: the mpris module always renders a label,
  // so its island pill showed up as an empty capsule whenever nothing was
  // playing. hide-empty-text removes the module instead, so the pill only
  // exists while there is something to show.
  "modules-center": ["custom/media"],
  "modules-right": [
    "tray",
    "wireplumber",
    "backlight",
    "battery",
    "clock"
  ],
  "niri/workspaces": {
    "format": "{value}"
  },

  "custom/media": {
    "exec": "bash ~/.config/waybar/scripts/media-title.sh",
    "interval": 2,
    "hide-empty-text": true,
    "max-length": 40
  },

  "tray": {
    "icon-size": 14,
    "spacing": 4
  },
  "custom/cpucat": {
    "exec": "bash ~/.config/waybar/scripts/catloop.sh"
  },
  "wireplumber": {
    "scroll-step": 5,
    "format": " {icon} {volume}%",
    "format-muted": "󰝟 muted",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"],
      "headphones": "󰋋",
      "headset": "󰋎"
    }
  },

  "backlight": {
    "format": " {icon} {percent}% ",
    "format-icons": ["󰃞", "󰃟", "󰃠"]
  },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon} {capacity}% ",
    "format-charging": "󰂄 {capacity}% ",
    "format-plugged": "󱟦 {capacity}% ",
    "format-full": "󰁹 {capacity}% ",
    "format-icons": [
      "󰂎", "󰁺", "󰁻", "󰁼", "󰁽",
      "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"
    ]
  },

  "clock": {
    "format": "{:%m-%d-%Y %I:%M %p}"
  }
}

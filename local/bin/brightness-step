#!/usr/bin/env bash
#
# Step the backlight, and power the panel off completely at 0%.
#
# Why this exists: brightnessctl can drive the backlight to 0, but on this panel
# the LCD still emits light at 0 -- the backlight is off while the display is
# still lit, so a "0% brightness" screen is not a dark screen. Niri's
# power-off-monitors is what actually makes it black, so 0% is where the two are
# joined up: drop to 0 and the monitor goes to DPMS off, raise the brightness and
# it comes back.
#
#   brightness-step down   step down; at 0, power the monitor off
#   brightness-step up     power the monitor back on if it is off, then step up
#
# Niri does not report DPMS state in `niri msg -j outputs`, so "is it off" is
# tracked with a marker in the runtime dir. Per-session by construction: it
# disappears on logout, so a stale marker can never claim a live monitor is off.

set -uo pipefail

STEP="${BRIGHTNESS_STEP:-5}"

marker="${XDG_RUNTIME_DIR:-/tmp}/niri-monitor-powered-off"

# Run an action, but only if we are actually inside a niri session. This is
# bound to a key with allow-when-locked, so it can fire from the lock screen
# where the session vars may not be set the same way.
niri_action() {
    local action="$1"
    if ! command -v niri >/dev/null 2>&1; then
        return 1
    fi
    if [[ -z "${NIRI_SOCKET:-}" ]] && ! pgrep -x niri >/dev/null 2>&1; then
        return 1
    fi
    niri msg action "$action" >/dev/null 2>&1
}

current_brightness() { brightnessctl g 2>/dev/null || echo 0; }
max_brightness() { brightnessctl m 2>/dev/null || echo 0; }

# Integer percent, rounded, so 3/937 counts as 0 rather than 0.3.
brightness_percent() {
    local cur max
    cur=$(current_brightness)
    max=$(max_brightness)
    if [[ "$max" -le 0 ]]; then
        echo 0
        return
    fi
    echo $(((cur * 100 + max / 2) / max))
}

icon_for() {
    case "$1" in
        0)  echo "notification-display-brightness-low" ;;
        1)  echo "notification-display-brightness-off" ;;
        100) echo "notification-display-brightness-full" ;;
        *)  if   (( $1 > 70 )); then echo "notification-display-brightness-high"
            elif (( $1 > 45 )); then echo "notification-display-brightness-medium"
            else echo "notification-display-brightness-medium"
            fi ;;
    esac
}

case "${1-}" in
    up)
        # If the monitor is off, this key is what brings it back, so the DPMS
        # change has to happen before the step -- otherwise the step lands on a
        # dark screen and looks like nothing happened.
        if [[ -e "$marker" ]]; then
            rm -f "$marker"
            niri_action power-on-monitors
            sleep 0.2
        fi
        brightnessctl set "$STEP%+" >/dev/null 2>&1
        ;;
    down)
        # Already off: stay off rather than pointlessly walking the backlight
        # down to its floor.
        if [[ -e "$marker" ]]; then
            exit 0
        fi
        brightnessctl set "$STEP%-" >/dev/null 2>&1
        if [[ "$(brightness_percent)" -le 0 ]]; then
            if niri_action power-off-monitors; then
                : > "$marker"
            fi
        fi
        ;;
    *)
        echo "usage: $(basename "$0") up|down" >&2
        exit 1
        ;;
esac

# Tell the user where they ended up, because a black screen gives no feedback at
# all and the next step up would otherwise look like it did nothing.
if command -v notify-send >/dev/null 2>&1; then
    if [[ -e "$marker" ]]; then
        notify-send --app-name="Brightness" \
            --icon="notification-display-brightness-off" \
            "Display off" "Brightness at 0% -- press the brightness key to wake" \
            -h "string:x-canonical-private-synchronous:brightness" >/dev/null 2>&1
    else
        pct=$(brightness_percent)
        notify-send --app-name="Brightness" --icon="$(icon_for "$pct")" \
            "Brightness" "${pct}%" \
            -h "string:x-canonical-private-synchronous:brightness" >/dev/null 2>&1
    fi
fi

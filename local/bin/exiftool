#!/usr/bin/env bash
#
# exiftool wrapper.
#
# Arch's perl-image-exiftool installs its script as /usr/bin/vendor_perl/exiftool
# and declares only "Provides: exiftool" at the package level, so it does not
# put an exiftool command on $PATH. Anything that shells out to exiftool --
# yazi's reveal opener, for one -- gets "command not found" and exit 127, which
# is exactly the vi-in-yazi problem this repo already hit once.
#
# This points at the vendor path. The fallback is for a future package that
# ships /usr/bin/exiftool properly, in which case this can be deleted.

for candidate in /usr/bin/vendor_perl/exiftool /usr/bin/exiftool; do
    if [[ -x $candidate ]]; then
        exec "$candidate" "$@"
    fi
done

echo "exiftool: no exiftool found (looked in /usr/bin/vendor_perl/exiftool and /usr/bin/exiftool)" >&2
exit 127

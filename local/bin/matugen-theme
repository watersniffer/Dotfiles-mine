#!/usr/bin/env bash
# matugen-theme -- generate the desktop palette from a wallpaper and publish it
# to everything that reads a generated color file.
#
# Called automatically by Matuwall's on_apply hook (see
# ~/.config/matuwall/config.toml) and once at session start, so the theme
# always matches the wallpaper. Can also be run by hand:
#
#   matugen-theme                  # use the wallpaper awww is showing
#   matugen-theme /path/to/img     # use that image
#
# Options:
#   --mode light|dark|smart        palette mode (default: dark)
#   --scheme NAME                  matugen scheme (default: the one in
#                                  ~/.config/matugen/config.toml)
#   --quiet                        no notification
#   --no-niri                      leave the niri window border alone
set -uo pipefail

MODE="dark"
QUIET=0
TOUCH_NIRI=1
# The scheme lives here, not in config.toml: matugen 4.2 ignores `type` in the
# config file and only honours the --type flag. Verified by passing the same
# file with -c and getting a different palette back.
SCHEME="scheme-vibrant"
WALLPAPER=""

positional=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --mode) MODE="${2:-dark}"; shift 2 || shift ;;
        --mode=*) MODE="${1#--mode=}"; shift ;;
        --scheme) SCHEME="${2:-}"; shift 2 || shift ;;
        --scheme=*) SCHEME="${1#--scheme=}"; shift ;;
        --quiet) QUIET=1; shift ;;
        --no-niri) TOUCH_NIRI=0; shift ;;
        -*) shift ;;
        # Hooks are split on whitespace, so a wallpaper name containing spaces
        # arrives as several arguments. The path is always the last one.
        *) positional+=("$1"); shift ;;
    esac
done
if [[ ${#positional[@]} -gt 0 ]]; then
    WALLPAPER="${positional[${#positional[@]}-1]}"
fi

wallpaper_dir="$HOME/Pictures/Wallpapers"

# 1. Work out which wallpaper to use.
if [[ -z "$WALLPAPER" || ! -f "$WALLPAPER" ]]; then
    WALLPAPER=$(awww query 2>/dev/null |
        sed -n 's/.*currently displaying: image: //p' | head -n1)
fi
if [[ -z "$WALLPAPER" || ! -f "$WALLPAPER" ]]; then
    WALLPAPER=$(find "$wallpaper_dir" -maxdepth 1 -type f -print 2>/dev/null | sort | head -n1)
fi
if [[ -z "$WALLPAPER" || ! -f "$WALLPAPER" ]]; then
    echo "matugen-theme: no wallpaper found" >&2
    exit 1
fi

# 2. Generate every template in ~/.config/matugen/config.toml.
if ! matugen image "$WALLPAPER" --mode "$MODE" --type "$SCHEME" \
        --prefer value --quiet; then
    echo "matugen-theme: matugen failed for $WALLPAPER" >&2
    exit 1
fi

# 3. Qt wants #AARRGGBB, not the #rrggbb the template emits.
qt_conf="$HOME/.config/qt6ct/colors/Monochrome.conf"
if [[ -f "$qt_conf" ]]; then
    qt_tmp=$(mktemp) || exit 1
    if sed -E 's/#([0-9a-fA-F]{6})/#ff\U\1/g' "$qt_conf" >"$qt_tmp"; then
        cat "$qt_tmp" >"$qt_conf"
    fi
    rm -f "$qt_tmp"
fi

# 4. Keep the niri window border on the wallpaper palette. Niri has no include
#    directive, so the two colours are patched into config.kdl in place -- the
#    inode is preserved (a rename would break niri's config watcher) and the
#    result is validated before it replaces anything.
if [[ "$TOUCH_NIRI" -eq 1 && -f "$HOME/.config/niri/config.kdl" ]]; then
    python3 - "$HOME/.config/niri/config.kdl" <<'PY' || true
import re
import subprocess
import sys
import tempfile
from pathlib import Path

config = Path(sys.argv[1]).resolve()
scheme = Path.home() / ".config/waybar/colors.css"


def matugen_hex(name: str) -> str | None:
    """Read one colour back out of the palette matugen just wrote."""
    match = re.search(rf"^@define-color {name} (#[0-9a-fA-F]{{6}});",
                      scheme.read_text(), re.M)
    return match.group(1) if match else None


# The border tracks the accent: bright while focused, muted outline otherwise.
primary = matugen_hex("cpucat")
muted = matugen_hex("ws_inactive")
if not primary or not muted:
    sys.exit(0)

text = config.read_text()
match = re.search(r"^([ \t]*)border \{.*?^\1\}", text, re.S | re.M)
if not match:
    sys.exit(0)

block = match.group(0)
updated = re.sub(r'(active-color\s+")#[0-9a-fA-F]{6}(")',
                 rf'\g<1>{primary}\g<2>', block)
updated = re.sub(r'(inactive-color\s+")#[0-9a-fA-F]{6}(")',
                 rf'\g<1>{muted}\g<2>', updated)
if updated == block:
    sys.exit(0)

new_text = text[:match.start()] + updated + text[match.end():]
with tempfile.NamedTemporaryFile("w", dir=config.parent, delete=False) as handle:
    handle.write(new_text)
    candidate = handle.name
try:
    subprocess.run(["niri", "validate", "-c", candidate],
                   check=True, capture_output=True)
except (subprocess.CalledProcessError, FileNotFoundError):
    Path(candidate).unlink(missing_ok=True)
    sys.exit(0)

# Write through the original inode so niri's inotify watch stays attached.
with open(config, "w") as handle:
    handle.write(new_text)
Path(candidate).unlink(missing_ok=True)
PY
fi

# 4b. Theme the Matuwall picker to match. Matuwall takes its colours from its
#     own config file, so the generated values are patched into it in place.
#     The result is parsed as TOML before anything is written, and the file is
#     rewritten through the original inode.
if [[ -f "$HOME/.config/matuwall/config.toml" ]]; then
    python3 - <<'PY' || true
import re
import sys
import tomllib
from pathlib import Path

palette = Path.home() / ".config/matugen/matuwall-colors.conf"
config = Path.home() / ".config/matuwall/config.toml"

values = {}
for line in palette.read_text().splitlines():
    line = line.strip()
    # Only whole-line comments: every value here starts with "#", so inline
    # comment stripping would eat the colour itself.
    if not line or line.startswith("#") or "=" not in line:
        continue
    key, value = (part.strip() for part in line.split("=", 1))
    value = value.strip('"')
    if re.fullmatch(r"#[0-9a-fA-F]{6,8}", value):
        values[key] = value

# (section, key in the config) -> key in the generated palette
mapping = {
    ("window", "background"): "window_background",
    ("colors", "tile"): "tile",
    ("colors", "border"): "tile_border",
    ("colors", "shadow"): "shadow",
    ("colors", "ring"): "ring",
    ("colors", "spinner"): "spinner",
}
missing = [src for src in mapping.values() if src not in values]
if not values or missing:
    sys.exit(0)

lines = config.read_text().splitlines(keepends=True)
section = None
changed = False
for index, line in enumerate(lines):
    header = re.match(r"\s*\[([^\]]+)\]\s*$", line)
    if header:
        section = header.group(1).strip()
        continue
    for (want_section, key), source in mapping.items():
        if section != want_section:
            continue
        pattern = re.compile(rf'^(\s*{re.escape(key)}\s*=\s*)"[^"]*"(.*)$')
        if pattern.match(line):
            updated = pattern.sub(rf'\g<1>"{values[source]}"\g<2>', line)
            if updated != line:
                lines[index] = updated
                changed = True
            break

if not changed:
    sys.exit(0)

updated_text = "".join(lines)
try:
    tomllib.loads(updated_text)
except tomllib.TOMLDecodeError:
    sys.exit(0)
config.write_text(updated_text)
PY
fi

# 4c. Theme the notification daemon. Mako cannot reload its config live, so it
#     is restarted afterwards; its config is patched in place here.
if [[ -f "$HOME/.config/mako/config" ]]; then
    python3 - <<'PY' || true
import re
import sys
from pathlib import Path

palette = Path.home() / ".config/matugen/mako-colors.conf"
config = Path.home() / ".config/mako/config"

# section name -> {key in mako's config: key in the generated palette}
values: dict[str, dict[str, str]] = {}
section = None
for line in palette.read_text().splitlines():
    line = line.strip()
    if not line or line.startswith("#"):
        continue
    if line.startswith("[") and line.endswith("]"):
        section = line[1:-1].strip()
        values.setdefault(section, {})
        continue
    if "=" not in line or section is None:
        continue
    key, value = (part.strip() for part in line.split("=", 1))
    if re.fullmatch(r"#[0-9a-fA-F]{6,8}", value):
        values[section][key] = value

if not values:
    sys.exit(0)

mapping = {
    "background-color": "background",
    "text-color": "text",
    "border-color": "border",
}

original_text = config.read_text()
lines = original_text.splitlines(keepends=True)
current = "default"  # mako's global block, before any [urgency=...] header
changed = False
for index, line in enumerate(lines):
    header = re.match(r"\s*\[urgency=(\w+)\]", line)
    if header:
        current = header.group(1)
        continue
    for mako_key, source in mapping.items():
        # Substitute in place rather than rebuilding the line: rebuilding from
        # the match groups drops the trailing newline and welds the file into
        # one unparseable line.
        pattern = re.compile(
            rf"^(\s*{re.escape(mako_key)}\s*=\s*)(\S+?)([ \t]*)(\r?\n)?$")
        if not pattern.match(line):
            continue
        colour = values.get(current, {}).get(source)
        if not colour:
            break
        updated = pattern.sub(rf"\g<1>{colour}\g<3>\g<4>", line)
        if updated != line:
            lines[index] = updated
            changed = True
        break

if not changed:
    sys.exit(0)

updated_text = "".join(lines)
# Refuse anything that is not obviously still a valid mako config: every key it
# needs must survive, and no line may have been lost or joined.
required = ["background-color=", "text-color=", "border-color=", "font="]
if not all(key in updated_text for key in required):
    sys.exit(0)
if len(updated_text.splitlines()) != len(original_text.splitlines()):
    sys.exit(0)
config.write_text(updated_text)
PY
fi

# 5. Tell the running clients to pick the new colours up.
#    Waybar needs no signal and no restart: both configs set
#    "reload_style_on_change": true, so it watches the stylesheet and the
#    colors.css that it imports, and repaints in place. Restarting it from here
#    made two bars overlap for a frame, and SIGUSR1 does not even reload -- its
#    default action is to toggle the bar's visibility. If no bar is running,
#    leave it that way: hiding it is what toggle-waybar is for.

#    Kitty can re-colour its running windows over its remote-control socket.
if command -v kitty >/dev/null 2>&1; then
    kitty @ set-colors --all --configured >/dev/null 2>&1 || true
fi

#    Mako has no reload path (makoctl cannot re-read the config), so restart it.
#    Only if it is already running: starting it here would resurrect a daemon
#    the user stopped on purpose.
if pgrep -x mako >/dev/null 2>&1; then
    pkill -x mako 2>/dev/null || true
    for _ in {1..20}; do
        pgrep -x mako >/dev/null 2>&1 || break
        sleep 0.05
    done
    setsid mako >/dev/null 2>&1 &
fi

#    Niri picked up config.kdl on its own, but ask explicitly so the reload
#    does not depend on the watcher.
if [[ -n "${NIRI_SOCKET:-}" ]] && command -v niri >/dev/null 2>&1; then
    niri msg action load-config-file >/dev/null 2>&1 || true
fi

#    Rofi and anything else that reads colors.rasi at launch needs nothing.
if [[ "$QUIET" -eq 0 ]] && command -v notify-send >/dev/null 2>&1; then
    notify-send --app-name=matugen-theme --expire-time=2500 \
        -i preferences-desktop-theme "Theme updated" \
        "$(basename "$WALLPAPER")" >/dev/null 2>&1 || true
fi

#!/usr/bin/env bash
set -euo pipefail

socket_name=${NIRI_SOCKET:-}
if [[ -z "$socket_name" ]]; then
    socket_name=$(pgrep -n -x niri 2>/dev/null || true)
fi
socket_name=${socket_name##*/}
marker="${XDG_RUNTIME_DIR:-/tmp}/niri-startup-${socket_name:-unknown}.done"

if [[ -e "$marker" ]]; then
    exit 0
fi
: > "$marker"

# DankMaterialShell owns the bar, notifications, clipboard, network, polkit and
# the lock/idle handling, and dms.service claims the
# org.freedesktop.Notifications bus name -- so anything competing with it has to
# be gone before it starts, or you get two bars and no notifications at all.
for daemon in waybar mako dunst nm-applet; do
    pkill -x "$daemon" >/dev/null 2>&1 || true
done

systemctl --user restart xdg-desktop-portal.service >/dev/null 2>&1 || true

# No wallpaper daemon here: DMS owns the desktop background. Leaving awww
# running alongside it means two daemons committing the same layer, which
# flickers and leaves the two disagreeing about what is showing.

"$HOME/.local/bin/at_startup" >/dev/null 2>&1 &

# No cliphist watcher: DMS keeps the clipboard history and Mod+C now opens it.

if command -v kitty >/dev/null 2>&1; then
    kitty >/dev/null 2>&1 &
fi

#!/bin/bash

if ! which powerprofilesctl >/dev/null 2>&1; then
    echo "You don't have powerprofilesctl."
    echo "Power profiles are not supported"
    exit 1
fi

PREVIOUS_PROFILE=$(powerprofilesctl get)
PROFILE_CHANGED=0

ON_BATTERY=false
for status_file in /sys/class/power_supply/BAT*/status; do
    if [[ -r "$status_file" && "$(<"$status_file")" == "Discharging" ]]; then
        ON_BATTERY=true
        break
    fi
done

if [[ "$PREVIOUS_PROFILE" != "performance" && "$ON_BATTERY" != true ]]; then
    powerprofilesctl set performance
    PROFILE_CHANGED=1
fi

systemd-inhibit --what=idle -- "$@"

if [ "$PROFILE_CHANGED" = 1 ]; then
    powerprofilesctl set "$PREVIOUS_PROFILE"
fi

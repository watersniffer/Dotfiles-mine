#!/bin/bash

if [[ $# -ne 1 ]]; then
    echo "Usage: $0 <playerctl-volume-argument>"
    echo "Example: $0 0.1+"
    exit 1
fi

if ! playerctl volume "$1"; then
    exit 1
fi

icon=$(playerctl -l 2>/dev/null | head -n 1 | cut -d '.' -f 1)
volume=$(playerctl volume 2>/dev/null)
[[ -n "$volume" ]] || exit 0
volume_int=$(printf "%.0f" "$(echo "$volume * 100" | bc -l)")

notify-send --app-name "$0" --icon "$icon" \
            "Current volume is: $volume_int%" \
            -h "string:x-canonical-private-synchronous:$0"

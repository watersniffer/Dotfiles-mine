#!/bin/bash
set -euo pipefail

# Drop the blur/shadow/power-profile changes for the current session by asking
# the root helper to do it. The compositor-specific part used to live here and
# was removed with Hyprland; niri applies the same PPD profile changes through
# the helper.
ROOT_HELPER=/usr/local/sbin/dotfiles-powersave

if [[ "$EUID" -ne 0 ]]; then
    if [[ ! -x "$ROOT_HELPER" ]]; then
        echo "Root helper is missing: $ROOT_HELPER" >&2
        exit 1
    fi
    exec pkexec "$ROOT_HELPER"
fi

exec "$ROOT_HELPER"

#!/bin/sh
# scratchpad -- show or hide a scratchpad window, running whatever app you like.
#
# Bound to Super+S.
#
#   scratchpad              toggle the scratchpad (an empty shell, unless `set`)
#   scratchpad pick         ask which app, every time
#   scratchpad set <cmd>    make <cmd> what Super+S toggles
#   scratchpad <cmd...>     open that command now, without toggling
#
# WHY THIS IS A SCRIPT AND NOT A BIND
# -----------------------------------
# Hyprland has no scratchpad, so the window is an ordinary window made
# borderless, gapless and floating by the window rules in
# config/hypr/hyprland.lua. Two things are left, and neither can be a bind.
#
# The first is that one key must both open and close. The second is *how* to close,
# and on this Hyprland nothing outside the window can close it. Every dispatch
# route was tried against a real window of the right class:
#
#   hyprctl dispatch killwindow class:scratchpad
#       -> expands to hl.dispatch(killwindow class:scratchpad), invalid Lua
#   hyprctl eval 'return hl.dsp.window.close()'
#       -> answers "ok" and the window stays open
#   hyprctl eval 'return hl.dsp.close_window()'
#       -> "attempt to call a nil value"
#
# So the window closes itself: this script launches it under a supervisor that
# leaves a watcher on a flag file, and pressing the key again drops that flag.
#
# WHY THERE IS NO `kitty` ANYWHERE IN THIS FILE
# ---------------------------------------------
# The previous version ended in `exec kitty --class scratchpad -e ...`, so the
# scratchpad was always a terminal running your shell, with no way to put
# anything else in it. The app is now configuration rather than a constant, and
# the default is deliberately nothing at all: an empty shell, so the app launcher
# (Super+Space) is one key away from inside the scratchpad and anything can be
# launched from there. `scratchpad set` overrides that if you would rather a
# specific app were already waiting.
#
# HOW TO SAY WHAT TO RUN
# ----------------------
# The command is a normal shell command line, with two optional prefixes:
#
#   term:<cmd>    run it inside kitty, for things that need a terminal
#                 (nvim, htop, btop, python, ssh). This is the usual case for
#                 anything that reads stdin.
#   <cmd>         run it directly. Nothing is appended unless it is a terminal
#                 emulator that is known to accept --class.
#
# With no prefix, a GUI app is launched bare, which means it reports its own
# window class and the scratchpad window rules will *not* match it -- it opens as
# an ordinary window. That is a property of how GTK and Qt set their class, not
# something this script can fix, and it is why `term:` exists as the reliable
# path rather than the fallback.
#
# The file is ~/.config/scratchpad/cmd, one line. `scratchpad set` writes it.

set -u

RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
STATE="$RUNTIME/scratchpad"
PIDFILE="$STATE/pid"
CLOSE="$STATE/close"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/scratchpad/cmd"

# Terminal emulators that accept --class, so the scratchpad rules match them.
# gnome-terminal and konsole take --class too but are left out because they
# ignore it for the WM_CLASS that Hyprland reads.
CLASS_AWARE="kitty alacritty foot wezterm ghostty xterm"

say() { notify-send -a scratchpad -u low "scratchpad" "$1" 2>/dev/null || true; }

# ---------------------------------------------------------------- open / close

running_pid() {
    [ -f "$PIDFILE" ] || return 1
    pid=$(cat "$PIDFILE" 2>/dev/null) || return 1
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    printf '%s' "$pid"
}

request_close() {
    : > "$CLOSE"
    # Give the supervisor a moment so the key does not feel dead, and so two quick
    # presses cannot race into "close" then "open" of the same window.
    i=0
    while [ "$i" -lt 20 ]; do
        if ! running_pid >/dev/null 2>&1; then
            # Gone. The pid file is cleaned here rather than by the watcher,
            # because the watcher is in the process group it kills and so does not
            # reliably reach its own cleanup.
            rm -f "$PIDFILE"
            return 0
        fi
        sleep 0.1
        i=$((i + 1))
    done
    # Still alive after 2s, so it ignored the request. Clear the stale pid so the
    # next press starts fresh rather than being swallowed retrying a close.
    rm -f "$PIDFILE"
}

# ------------------------------------------------------------------- launching

launch() {
    spec=$1
    mode=direct
    case $spec in
        term:*) mode=terminal; spec=${spec#term:} ;;
    esac

    rm -f "$CLOSE"
    mkdir -p "$STATE" 2>/dev/null || true

    if [ "$mode" = terminal ]; then
        # kitty is the terminal because it is what is installed and because it
        # takes --class, so the result still matches the scratchpad rules.
        setsid "$0" --supervise kitty --class scratchpad -e "$spec" \
            >/dev/null 2>&1 </dev/null &
    else
        first=${spec%% *}
        base=${first##*/}
        add_class=""
        for c in $CLASS_AWARE; do
            [ "$base" = "$c" ] && add_class="--class scratchpad"
        done
        # shellcheck disable=SC2086
        setsid "$0" --supervise $spec $add_class >/dev/null 2>&1 </dev/null &
    fi
}

# ------------------------------------------------------------------ supervisor
#
# Internal. Reached as `scratchpad --supervise <cmd...>`, always via setsid from
# launch(), so this process is a session and process-group leader. That is what
# makes `kill -- -$$` below mean "everything this scratchpad started", including
# anything the app forked.
supervise() {
    # Deliberately no `shift` here. The caller has already consumed --supervise,
    # and shifting a second time is what broke this: `scratchpad sleep 60` reached
    # this function as "sleep 60" and left it as "60", so it ran `exec 60`, died
    # immediately with "60: not found", and the EXIT trap below deleted the pid
    # file on the way out. The symptom was a scratchpad that did nothing at all
    # and an empty state directory.
    if [ $# -eq 0 ]; then
        echo "scratchpad: --supervise needs a command to run" >&2
        exit 2
    fi

    # Create the state dir here too, not only in launch, so this mode works when
    # invoked directly rather than only through launch.
    mkdir -p "$STATE" 2>/dev/null || true
    if ! echo $$ > "$PIDFILE" 2>/dev/null; then
        echo "scratchpad: cannot write $PIDFILE" >&2
        exit 1
    fi

    trap 'rm -f "$PIDFILE"' EXIT INT TERM

    # Remember who we are before the exec, because after it $$ is still the same
    # pid but the shell is gone -- and the watcher below needs to be able to ask
    # "is the app I am watching still there?".
    leader=$$

    (
        # Ignore TERM so the watcher survives long enough to tidy up. It is in the
        # same process group as the app it is about to kill, so without this it
        # receives its own signal first and dies mid-cleanup.
        trap '' TERM INT
        while :; do
            if [ -e "$CLOSE" ]; then
                rm -f "$CLOSE"
                rm -f "$PIDFILE"
                kill -TERM -- "-$$" 2>/dev/null
                sleep 0.4
                kill -KILL -- "-$$" 2>/dev/null
                break
            fi
            # If the app exited on its own -- `exit` in the shell, or the app
            # crashed -- stop polling. Checking only for the close flag leaks: a
            # watcher whose app is already gone would sit in this loop for the
            # rest of the session, and a burst of those adds up.
            if ! kill -0 "$leader" 2>/dev/null; then
                rm -f "$PIDFILE"
                break
            fi
            sleep 0.3
        done
    ) &
    exec "$@"
}

# ------------------------------------------------------------------- selection

pick_command() {
    printf '%s\n' \
        'term:nvim' \
        'term:btop' \
        'term:htop' \
        'term:$SHELL' \
        'kitty' \
        'foot' \
        | rofi -dmenu -i -p "scratchpad"
}

# ------------------------------------------------------------------------ main

[ "${1-}" = "--supervise" ] && { shift; supervise "$@"; exit 0; }

case "${1-}" in
    set)
        shift
        if [ $# -eq 0 ]; then
            echo "usage: scratchpad set <command>" >&2
            exit 1
        fi
        mkdir -p "$(dirname "$CONFIG")"
        printf '%s\n' "$*" > "$CONFIG"
        say "Super+S will now run: $*"
        exit 0
        ;;
    pick)
        spec=$(pick_command) || exit 0
        [ -n "$spec" ] || exit 0
        launch "$spec"
        exit 0
        ;;
esac

# With arguments, open exactly that, without toggling.
if [ $# -gt 0 ]; then
    launch "$*"
    exit 0
fi

# Toggle mode. If the key is pressed while something is open, that wins: an
# explicit command is for a first run or a deliberate override, not a way to
# spawn a second scratchpad.
if running_pid >/dev/null 2>&1; then
    request_close
    exit 0
fi

if [ -s "$CONFIG" ]; then
    launch "$(head -1 "$CONFIG")"
else
    # Empty by default: a plain shell, nothing preset. Deliberately not written to
    # the config, so it stays empty on every press until `scratchpad set` is used
    # -- an earlier version asked on the first press and remembered the answer,
    # which quietly turned the scratchpad into that one app forever.
    launch "term:${SHELL:-/bin/sh}"
fi

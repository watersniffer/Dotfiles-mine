#!/bin/sh
# scratchpad-session -- the scratchpad window's command.
#
# Run by kitty as `kitty --class scratchpad -e scratchpad-session`, so it is the
# window's process. It has two jobs: give the user a shell, and arrange for the
# window to be closable from outside.
#
# The closing part is here rather than in toggle-scratchpad because nothing outside
# the window can close it. Every Hyprland dispatch route is broken on this build --
# `hyprctl dispatch killwindow` expands to invalid Lua and `hyprctl eval
# 'return hl.dsp.window.close()'` answers "ok" without closing anything -- so
# Super+S drops a flag file and this script's watcher acts on it by killing kitty.
#
# Killing kitty rather than exiting the shell is deliberate. Exiting would work too,
# but only if the user had not started something else in the window: `nvim` in the
# scratchpad and then Super+S would leave nvim running with no window. Killing the
# terminal takes the whole process group with it, which is the behaviour a
# scratchpad wants.
#
# The watcher is backgrounded before the exec, so the shell it leaves behind is
# interactive and unaffected by it, and it holds kitty's pid captured beforehand --
# after `exec`, $PPID would be the shell's parent rather than the terminal's.

set -u

FLAG="${XDG_RUNTIME_DIR:-/tmp}/scratchpad-close"

# kitty is this script's parent. Captured before the exec below replaces it.
kitty_pid=$PPID

# Poll for the flag. 0.3s is a compromise: fast enough that the key feels
# instant, slow enough that a shell doing nothing costs almost nothing. This is a
# sleep in a shell, not a process per tick.
(
    while [ ! -e "$FLAG" ]; do
        sleep 0.3
    done
    # Clear the flag before killing, so the next scratchpad does not open already
    # "flagged" and close itself immediately.
    rm -f "$FLAG"
    kill "$kitty_pid" 2>/dev/null
) &

exec "${SHELL:-/bin/sh}"

#!/bin/bash

if pgrep -x "wf-recorder" > /dev/null; then
    pkill -x wf-recorder
    notify-send --app-name "$0" \
                --icon view-list-video-symbolic \
                "Finished recording" "wf-recorder"
    exit 0
fi

VIDEOS_DIR="${XDG_VIDEOS_DIR:-$HOME/Videos}"
mkdir -p "$VIDEOS_DIR"
FILE="$VIDEOS_DIR/record-$(date +"%Y-%m-%d_%H-%M-%S").mp4"

mapfile -t MONITOR_SOURCES < <(
    pactl list sources 2>/dev/null \
        | sed -n 's/^[[:space:]]*Name:[[:space:]]*//p' \
        | grep '\.monitor$'
)

AUDIO_SOURCE=""
for source in "${MONITOR_SOURCES[@]}"; do
    if [[ "$source" == bluez_output.* ]]; then
        AUDIO_SOURCE="$source"
        break
    fi
done
if [[ -z "$AUDIO_SOURCE" ]]; then
    for source in "${MONITOR_SOURCES[@]}"; do
        if [[ "$source" == alsa_output.* ]]; then
            AUDIO_SOURCE="$source"
            break
        fi
    done
fi

if [[ "${1:-}" == "--select" ]]; then
    AREA_ARGS=(-g "$(slurp)")
else
    AREA_ARGS=()
fi

notify-send --app-name "$0" \
            --icon view-list-video-symbolic \
            "Recording..." "wf-recorder"

WF_ARGS=(-D --file "$FILE" -c libx264 -x libx264rgb)
if [[ -n "$AUDIO_SOURCE" ]]; then
    WF_ARGS+=(--audio="$AUDIO_SOURCE")
fi
wf-recorder "${AREA_ARGS[@]}" "${WF_ARGS[@]}"

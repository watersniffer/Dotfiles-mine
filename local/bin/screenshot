#!/bin/bash

PICTURES_DIR="${XDG_PICTURES_DIR:-$HOME/Pictures}"
SCREENSHOTS_DIR="$PICTURES_DIR/screenshots"
mkdir -p "$SCREENSHOTS_DIR"
FILE="$SCREENSHOTS_DIR/$(date +"%Y-%m-%d_%H-%M-%S").png"

if [[ "${1:-}" == "--select" ]]; then
    if command -v flameshot >/dev/null 2>&1; then
        flameshot gui --path "$FILE"
    else
        grim -g "$(slurp)" "$FILE"
    fi

    STATUS=$?
else
    grim "$FILE"
    STATUS=$?
fi

if [[ $STATUS -eq 0 ]]; then
    wl-copy < "$FILE" &

    notify-send --app-name "$0" \
                --icon "$FILE" \
                "New screenshot" "$FILE"
fi

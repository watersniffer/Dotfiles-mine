#!/usr/bin/env bash
set -euo pipefail

# Environment wrapper for the Hyprland session, started by SDDM.
#
# Mirrors local/bin/start-niri exactly -- same exports, same order, same
# reason. SDDM launches a desktop entry directly, so .bashrc never runs and
# ~/.local/bin is absent from PATH, which makes every bind that calls a script
# in there (themesw, wallpaper-switcher, powerprofile, toggle-waybar) fail with
# "command not found".
#
# The one difference is deliberate: the compositor config lives at
# config/hypr/hyprland.lua rather than config/niri/config.kdl, passed below.
# Hyprland 0.56 is lua-first, and its lua config is the only place the window
# rules, animations and hyprcursor settings can be expressed correctly.
# Everything else -- kitty, waybar, rofi, mako, the seven themes, awww -- is
# shared, so the two sessions look and behave the same.
#
# Waybar gets config-hypr.jsonc rather than config-niri.jsonc for one reason:
# the workspace module is hyprland/workspaces instead of niri/workspaces. The
# custom/media module is kept, which is the fix for the empty centre capsule.

unset WAYLAND_DISPLAY DISPLAY WAYLAND_SOCKET NIRI_SOCKET HYPRLAND_INSTANCE_SIGNATURE
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_DESKTOP=Hyprland
export XDG_SESSION_TYPE=wayland
export QT_QPA_PLATFORMTHEME=qt6ct
export QT_STYLE_OVERRIDE=kvantum
export QT_SCALE_FACTOR=0.92
export XCURSOR_SIZE=24
export XCURSOR_THEME=Bibata-Modern-Classic
export EDITOR=nvim
export VISUAL=nvim
export TERMINAL=kitty
export PATH="$HOME/.local/bin:$HOME/.local/share/flatpak/exports/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:/var/lib/flatpak/exports/bin"

# wl-paste refuses to start if these are absent.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export WAYLAND_DISPLAY=wayland-1

exec /usr/bin/Hyprland -c "$HOME/.config/hypr/hyprland.lua"

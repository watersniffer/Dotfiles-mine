#!/usr/bin/env bash
#
# Environment wrapper for the Hyprland session, started by SDDM.
#
# This exists only to get a usable session out of a stock Hyprland config.
# Everything Hyprland itself draws or binds comes from
# config/hypr/hyprland.lua, which is Hyprland's own shipped example config
# (/usr/share/hypr/hyprland.lua) used unmodified.
#
# The exports below are not compositor settings -- they are the same ones
# start-niri sets, and without them .bashrc never runs (SDDM launches a desktop
# entry directly), so ~/.local/bin is missing from PATH and every helper script
# would be unreachable.
set -euo pipefail

unset WAYLAND_DISPLAY DISPLAY WAYLAND_SOCKET NIRI_SOCKET HYPRLAND_INSTANCE_SIGNATURE
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_DESKTOP=Hyprland
export XDG_SESSION_TYPE=wayland

export PATH="$HOME/.local/bin:$HOME/.local/share/flatpak/exports/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:/var/lib/flatpak/exports/bin"

# wl-paste refuses to start if these are absent.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export WAYLAND_DISPLAY=wayland-1

exec /usr/bin/Hyprland -c "$HOME/.config/hypr/hyprland.lua"

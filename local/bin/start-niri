#!/usr/bin/env bash
set -euo pipefail

# SDDM starts the desktop entry directly, so establish the same application
# environment that the Hyprland Lua config provides.
unset WAYLAND_DISPLAY DISPLAY WAYLAND_SOCKET NIRI_SOCKET
export XDG_CURRENT_DESKTOP=niri
export XDG_SESSION_DESKTOP=niri
export XDG_SESSION_TYPE=wayland
export QT_QPA_PLATFORMTHEME=qt6ct
export QT_STYLE_OVERRIDE=kvantum
export QT_SCALE_FACTOR=0.92
export XCURSOR_SIZE=24
export XCURSOR_THEME=Bibata-Modern-Classic
export PATH="$HOME/.local/bin:$HOME/.local/share/flatpak/exports/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:/var/lib/flatpak/exports/bin"

exec /usr/bin/niri-session -l

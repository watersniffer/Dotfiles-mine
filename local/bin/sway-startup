#!/usr/bin/env bash
set -euo pipefail

socket_name=${SWAYSOCK:-}
socket_name=${socket_name##*/}
marker="${XDG_RUNTIME_DIR:-/tmp}/sway-startup-${socket_name:-unknown}.done"

if [[ -e "$marker" ]]; then
    exit 0
fi
: > "$marker"

# Keep startup work out of the Sway config so `swaymsg reload` does not spawn
# duplicate bars, terminals, daemons, or clipboard watchers.
mako >/dev/null 2>&1 &
dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK \
    XDG_CURRENT_DESKTOP=Sway XDG_SESSION_DESKTOP=sway >/dev/null 2>&1 || true
systemctl --user restart xdg-desktop-portal.service >/dev/null 2>&1 &
waybar -c "$HOME/.config/waybar/config-sway.jsonc" -s "$HOME/.config/waybar/style.css" >/dev/null 2>&1 &
"$HOME/.local/bin/at_startup" >/dev/null 2>&1 &
awww-daemon >/dev/null 2>&1 &
(
    for _ in {1..10}; do
        awww restore >/dev/null 2>&1 && exit 0
        sleep 0.2
    done
) &
nm-applet >/dev/null 2>&1 &
wl-paste --watch cliphist store >/dev/null 2>&1 &
if [[ -x /usr/lib/polkit-kde-authentication-agent-1 ]]; then
    /usr/lib/polkit-kde-authentication-agent-1 >/dev/null 2>&1 &
fi
if command -v kitty >/dev/null 2>&1; then
    kitty >/dev/null 2>&1 &
fi
if command -v swayidle >/dev/null 2>&1; then
    swayidle -w before-sleep 'swaylock -f' >/dev/null 2>&1 &
fi

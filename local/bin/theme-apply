# Colors for cpu box
theme[cpu_box]="{p['blue']}"
theme[cpu_bar]="{p['blue']}"
theme[cpu_text]="{p['fg0']}"

# Colors for mem box
theme[mem_box]="{p['magenta']}"
theme[mem_bar]="{p['magenta']}"
theme[mem_text]="{p['fg0']}"
theme[mem_cache]="{p['bg3']}"

# Colors for net box
theme[net_box]="{p['cyan']}"
theme[net_text]="{p['fg0']}"

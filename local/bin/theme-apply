#!/usr/bin/env python3
"""Apply a desktop theme from themes/<slug>/palette.conf to every app.

Called by themesw, but usable directly:

    theme-apply catppuccin-mocha
    theme-apply --no-wallpaper catppuccin-mocha
    theme-apply --list
    theme-apply --current

Each theme is one palette.conf holding generic roles (bg0..bg4, fg0..fg3 and
the eight accents). Everything an app needs is rendered from that, so adding a
theme means adding one file and nothing else.

Files fall into two groups:

  rendered   the file is pure palette, so it is rewritten in full
  patched    the file also holds content we must not touch (icon URLs, module
             lists, the user's compositor settings), so only its colour
             properties are substituted in place

Running apps are reloaded where that is possible; the rest need a restart and
are listed at the end.

Applying a theme also applies a wallpaper from the folder that theme names, so
the desktop and the palette move together. See next_wallpaper for why that
walk is round-robin rather than random, and --no-wallpaper to skip it.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

HOME = Path.home()


def find_repo() -> Path:
    """Locate the dotfiles checkout.

    install.sh *copies* local/bin into ~/.local/bin rather than symlinking it,
    so walking up from this file only works when the script is run out of the
    repo. Try the env override, then the path, then the usual clone location,
    and accept the first candidate that really looks like the checkout.
    """
    candidates = []
    if os.environ.get("DOTFILES_DIR"):
        candidates.append(Path(os.environ["DOTFILES_DIR"]))
    candidates.extend(SCRIPT_PATH.parents)
    candidates.append(HOME / "Dotfiles-mine")
    candidates.append(HOME / "dotfiles")

    for cand in candidates:
        if (cand / "themes").is_dir() and (cand / "config").is_dir():
            return cand
    die("cannot find the dotfiles checkout (looked for themes/ and config/ in: "
        + ", ".join(str(c) for c in candidates[:6]) + ", ...). "
        "Set DOTFILES_DIR to the checkout.")


SCRIPT_PATH = Path(os.path.realpath(__file__))
REPO = find_repo()
THEMES_DIR = REPO / "themes"
CONFIG = REPO / "config"

STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "theme-current"

# Where the themes' wallpapers live, and where the round-robin position is kept:
# one small file per theme, named after the theme, holding the image it last
# applied. A file per theme rather than one index in a single file, so a
# filename with a space or a quote in it cannot corrupt the state.
WALL_ROOT = HOME / "Pictures/Wallpapers"
WALL_STATE = STATE.parent / "theme-wallpaper"

# Apps whose config is a real directory rather than a symlink into the repo
# (nvim and qt6ct write state into them), so they need copying after the repo
# files are written.
MIRRORED = {
    "nvim": CONFIG / "nvim",
    "qt6ct": CONFIG / "qt6ct",
}


def die(msg: str) -> "None":
    print(f"theme-apply: {msg}", file=sys.stderr)
    raise SystemExit(1)


# --------------------------------------------------------------------------
# palettes
# --------------------------------------------------------------------------

# name, nvim, btop and vscode are identifiers or display names, not colours.
TEXT_ROLES = ("name", "nvim", "btop", "wallpapers")

ROLES = (
    "name", "nvim", "btop",
    "bg0", "bg1", "bg2", "bg3", "bg4",
    "fg0", "fg1", "fg2", "fg3",
    "red", "green", "yellow", "blue", "magenta", "cyan", "orange",
    "accent", "on_accent", "urgent",
)


def list_themes() -> list[Path]:
    if not THEMES_DIR.is_dir():
        return []
    return sorted(p for p in THEMES_DIR.iterdir() if (p / "palette.conf").is_file())


def load_palette(slug: str) -> dict:
    path = THEMES_DIR / slug / "palette.conf"
    if not path.is_file():
        known = ", ".join(p.name for p in list_themes()) or "none"
        die(f"no theme '{slug}' (have: {known})")

    pal: dict = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        # Only whole-line comments: every value is a #rrggbb colour, so
        # stripping from the first # would eat the value itself.
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        pal[key.strip()] = value.strip()

    missing = [r for r in ROLES if r not in pal]
    if missing:
        die(f"{slug}: palette.conf is missing {', '.join(missing)}")

    # nvim and btop name a colorscheme and a file, so neither may contain
    # whitespace. They are checked because a value with a trailing "# comment"
    # on the same line parses fine and then fails much later and silently: a
    # colorscheme that will not load just falls back, per theme.lua.
    # (name is allowed spaces -- it is a display name.)
    for role in ("nvim", "btop"):
        if re.search(r"\s", pal[role]):
            die(f"{slug}: {role} is {pal[role]!r}, which contains whitespace -- "
                "put any comment on its own line")

    for role, value in pal.items():
        if role in TEXT_ROLES:
            continue
        if not re.fullmatch(r"#[0-9a-fA-F]{6}", value):
            die(f"{slug}: {role} is not a #rrggbb colour ({value!r})")
    return pal


def rgb(hex_color: str) -> tuple[int, int, int]:
    h = hex_color.lstrip("#")
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def rgba(hex_color: str, alpha: float) -> str:
    r, g, b = rgb(hex_color)
    return f"rgba({r}, {g}, {b}, {alpha:g})"


def qt(hex_color: str) -> str:
    """qt6ct colours are #aarrggbb."""
    r, g, b = rgb(hex_color)
    return f"#ff{r:02x}{g:02x}{b:02x}"


def nvim_colorscheme_exists(name: str) -> bool:
    """Is there a colors/<name>.{lua,vim} for this nvim?

    Worth checking because theme.lua wraps the colorscheme call in a pcall and
    falls back to tokyonight, so a name that cannot load produces no error at
    all: switching to Gruvbox silently gave Tokyo Night until this was added.
    """
    roots = [HOME / ".config/nvim", HOME / ".local/share/nvim/lazy"]
    for root in roots:
        if not root.is_dir():
            continue
        candidates = [root / "colors" / f"{name}.lua", root / "colors" / f"{name}.vim"]
        candidates += [p for p in root.glob(f"*/colors/{name}.lua")]
        candidates += [p for p in root.glob(f"*/colors/{name}.vim")]
        if any(c.is_file() for c in candidates):
            return True
    return False


def render_vscode_theme(p: dict) -> str:
    """A VS Code theme file for this palette.

    VS Code has no equivalent of `colorscheme`: the only themes it ships are its
    own built-ins, and the matching community ones (Catppuccin, Gruvbox, ...) are
    extensions, each wanting a network install and a hand-picked name. Writing
    the theme here keeps VS Code in step with everything else in the desktop for
    the same reason the other nineteen files are generated rather than hand
    maintained.

    VS Code reads user themes from <user-data>/User/themes, and a flat .json
    file there is a valid theme, so this is written to
    ~/.config/Code/User/themes/<slug>.json.
    """
    name = f"Dotfiles: {p['name']}"

    # Workbench chrome, from the palette's own roles.
    colors = {
        "editor.background": p["bg0"],
        "editor.foreground": p["fg0"],
        "editorLineNumber.foreground": p["fg2"],
        "editorLineNumber.activeForeground": p["fg0"],
        "editorCursor.foreground": p["fg0"],
        "editor.selectionBackground": p["bg4"],
        "editor.lineHighlightBackground": p["bg2"],
        "editor.findMatchBackground": p["bg4"],
        "editor.findMatchHighlightBackground": p["bg3"],
        "editorWhitespace.foreground": p["bg4"],
        "editorIndentGuide.background1": p["bg3"],
        "editorIndentGuide.activeBackground1": p["bg4"],
        "editorGutter.background": p["bg0"],
        "editorWidget.background": p["bg2"],
        "editorHoverWidget.background": p["bg2"],
        "editorSuggestWidget.background": p["bg2"],
        "editorSuggestWidget.border": p["bg4"],
        "editorHoverWidget.border": p["bg4"],

        "sideBar.background": p["bg1"],
        "sideBar.foreground": p["fg0"],
        "sideBar.border": p["bg3"],
        "activityBar.background": p["bg1"],
        "activityBar.foreground": p["fg0"],
        "activityBar.inactiveForeground": p["fg2"],
        "activityBarBadge.background": p["accent"],
        "activityBarBadge.foreground": p["on_accent"],

        "titleBar.activeBackground": p["bg1"],
        "titleBar.activeForeground": p["fg0"],
        "titleBar.inactiveBackground": p["bg1"],
        "titleBar.inactiveForeground": p["fg2"],
        "titleBar.border": p["bg3"],

        "tab.activeBackground": p["bg0"],
        "tab.activeForeground": p["fg0"],
        "tab.inactiveBackground": p["bg1"],
        "tab.inactiveForeground": p["fg2"],
        "tab.border": p["bg3"],
        "tab.activeBorderTop": p["accent"],

        "statusBar.background": p["bg1"],
        "statusBar.foreground": p["fg0"],
        "statusBar.border": p["bg3"],
        "statusBar.noFolderBackground": p["bg1"],
        "statusBar.debugBackground": p["orange"],
        "statusBarItem.remoteBackground": p["accent"],
        "statusBarItem.remoteForeground": p["on_accent"],

        "panel.background": p["bg1"],
        "panel.border": p["bg3"],
        "panelTitle.activeForeground": p["fg0"],
        "panelTitle.inactiveForeground": p["fg2"],
        "panelSection.border": p["bg3"],

        "input.background": p["bg3"],
        "input.foreground": p["fg0"],
        "input.border": p["bg4"],
        "inputOption.activeBorder": p["accent"],
        "dropdown.background": p["bg3"],
        "dropdown.listBackground": p["bg2"],

        "list.activeSelectionBackground": p["bg3"],
        "list.activeSelectionForeground": p["fg0"],
        "list.inactiveSelectionBackground": p["bg2"],
        "list.hoverBackground": p["bg2"],
        "list.highlightForeground": p["accent"],
        "list.dropBackground": p["bg4"],

        "focusBorder": p["accent"],
        "foreground": p["fg0"],
        "descriptionForeground": p["fg2"],
        "errorForeground": p["urgent"],
        "widget.shadow": p["bg1"],
        "selection.background": p["bg4"],
        "icon.foreground": p["fg0"],
        "sash.hoverBorder": p["accent"],

        # diagnostics
        "editorError.foreground": p["urgent"],
        "editorWarning.foreground": p["yellow"],
        "editorInfo.foreground": p["blue"],
        "editorHint.foreground": p["fg2"],
        "editorError.border": "#00000000",
        "editorWarning.border": "#00000000",
        "editorInfo.border": "#00000000",
        "editorHint.border": "#00000000",
        "editorError.background": p["bg2"],
        "editorWarning.background": p["bg2"],
        "editorInfo.background": p["bg2"],
        "editorHint.background": p["bg2"],
        "editorOverviewRuler.border": "#00000000",
        "editorOverviewRuler.errorForeground": p["urgent"],
        "editorOverviewRuler.warningForeground": p["yellow"],
        "editorOverviewRuler.infoForeground": p["blue"],
        "editorOverviewRuler.addedForeground": p["green"],
        "editorOverviewRuler.modifiedForeground": p["yellow"],
        "editorOverviewRuler.deletedForeground": p["urgent"],

        # git decorations
        "gitDecoration.addedResourceForeground": p["green"],
        "gitDecoration.modifiedResourceForeground": p["yellow"],
        "gitDecoration.deletedResourceForeground": p["urgent"],
        "gitDecoration.untrackedResourceForeground": p["fg2"],
        "gitDecoration.ignoredResourceForeground": p["fg3"],
        "gitDecoration.conflictingResourceForeground": p["orange"],
        "gitDecoration.submoduleResourceForeground": p["blue"],

        # terminal
        "terminal.background": p["bg0"],
        "terminal.foreground": p["fg0"],
        "terminal.ansiBlack": p["bg3"],
        "terminal.ansiRed": p["red"],
        "terminal.ansiGreen": p["green"],
        "terminal.ansiYellow": p["yellow"],
        "terminal.ansiBlue": p["blue"],
        "terminal.ansiMagenta": p["magenta"],
        "terminal.ansiCyan": p["cyan"],
        "terminal.ansiWhite": p["fg1"],
        "terminal.ansiBrightBlack": p["fg2"],
        "terminal.ansiBrightRed": p["red"],
        "terminal.ansiBrightGreen": p["green"],
        "terminal.ansiBrightYellow": p["yellow"],
        "terminal.ansiBrightBlue": p["blue"],
        "terminal.ansiBrightMagenta": p["magenta"],
        "terminal.ansiBrightCyan": p["cyan"],
        "terminal.ansiBrightWhite": p["fg0"],
        "terminal.selectionBackground": p["bg4"],

        # scrollbars and badges
        "scrollbarSlider.background": p["bg4"],
        "scrollbarSlider.hoverBackground": p["fg3"],
        "scrollbarSlider.activeBackground": p["fg2"],
        "badge.background": p["accent"],
        "badge.foreground": p["on_accent"],
        "notebook.cellBorderColor": p["bg4"],
        "notebook.selectedCellBackground": p["bg2"],
    }

    # Token rules, mirroring the nvim colorschemes: same roles, same shades.
    def rule(*scopes, fg=None, bold=False, italic=False):
        settings = {}
        if fg:
            settings["foreground"] = fg
        if bold:
            settings["fontStyle"] = (settings.get("fontStyle", "") + " bold").strip()
        if italic:
            settings["fontStyle"] = (settings.get("fontStyle", "") + " italic").strip()
        return {"name": " ".join(scopes), "scope": list(scopes), "settings": settings}

    token_colors = [
        rule("comment", "punctuation.definition.comment", fg=p["fg3"], italic=True),
        rule("string", "string.quoted", fg=p["green"]),
        rule("constant.numeric", "constant.language", fg=p["cyan"]),
        rule("constant.language", "constant.character", fg=p["cyan"]),
        rule("variable", fg=p["fg1"]),
        rule("variable.parameter", fg=p["fg1"], italic=True),
        rule("keyword", "storage.type", "storage.modifier", fg=p["magenta"]),
        rule("keyword.control", "keyword.operator.new", fg=p["magenta"]),
        rule("keyword.operator", "keyword.other", fg=p["fg2"]),
        rule("entity.name.function", "support.function", "meta.function-call",
             fg=p["yellow"]),
        rule("entity.name.type", "entity.name.class", "support.type",
             "support.class", fg=p["cyan"]),
        rule("entity.name.tag", "meta.tag", fg=p["accent"]),
        rule("entity.other.attribute-name", "meta.attribute", fg=p["accent"]),
        rule("punctuation", "meta.brace", fg=p["fg2"]),
        rule("invalid", "invalid.illegal", fg=p["urgent"], bold=True),
        rule("markup.bold", fg=p["fg0"], bold=True),
        rule("markup.italic", fg=p["fg0"], italic=True),
        rule("markup.heading", fg=p["accent"], bold=True),
        rule("markup.underline.link", "string.other.link", fg=p["blue"]),
        rule("markup.inline.raw", fg=p["green"]),
        rule("markup.inserted", fg=p["green"]),
        rule("markup.deleted", fg=p["urgent"]),
        rule("markup.changed", fg=p["yellow"]),
    ]

    theme = {
        "$schema": "vscode://schemas/color-theme",
        "name": name,
        "type": "dark",
        "semanticHighlighting": True,
        "colors": colors,
        "tokenColors": token_colors,
    }
    return json.dumps(theme, indent=2) + "\n"


def set_vscode_theme(theme: str) -> bool:
    """Write workbench.colorTheme into VS Code's user settings.

    The file is JSONC and hand-edited, so it is edited as text rather than
    round-tripped through a parser: rewriting it with json.dumps would drop the
    user's comments and key order. A missing key is inserted before the closing
    brace, and an existing one is replaced in place.
    """
    path = HOME / ".config/Code/User/settings.json"
    if not path.is_file():
        return False

    key = '"workbench.colorTheme"'
    line = f'  {key}: "{theme}"'
    s = path.read_text(encoding="utf-8")

    if re.search(rf"^[ \t]*{re.escape(key)}\s*:", s, re.M):
        s = re.sub(rf"^[ \t]*{re.escape(key)}\s*:.*$", line, s, count=1, flags=re.M)
    else:
        # before the last closing brace
        idx = s.rstrip().rfind("}")
        if idx == -1:
            return False
        head = s[:idx].rstrip()
        needs_comma = head.rstrip() not in ("{", "")
        s = f"{head}{',' if needs_comma else ''}\n{line}\n{s[idx:]}\n"

    path.write_text(s, encoding="utf-8")
    return True


def slug_to_camel(slug: str) -> str:
    return "".join(part.capitalize() for part in re.split(r"[-_]", slug))


# --------------------------------------------------------------------------
# rendered files: pure palette, rewritten in full
# --------------------------------------------------------------------------

def render_waybar_colors(p: dict) -> str:
    return f"""/* {p['name']}. Generated by theme-apply from themes/{p['_slug']}/palette.conf --
   edit the palette, not this file.

   bg0..bg4 and fg0..fg3 are the generic roles; the names after @define-color
   are the ones style.css references. */

@define-color base {p['bg0']};
@define-color bg1 {p['bg1']};
@define-color bg2 {p['bg2']};
@define-color bg3 {p['bg3']};
@define-color bg4 {p['bg4']};

@define-color text {p['fg0']};
@define-color subtext {p['fg1']};
@define-color overlay2 {p['fg2']};
@define-color overlay0 {p['fg3']};

/* The bar itself is transparent (see style.css) and the module islands paint
   these, so the alpha is baked in. */
@define-color island {rgba(p['bg1'], 0.85)};
@define-color island_hover {rgba(p['bg2'], 0.9)};

/* The names style.css actually references. */
@define-color bg {p['bg1']};
@define-color fg {p['fg0']};
@define-color ws_inactive {p['bg3']};
@define-color ws_active {p['accent']};
@define-color hover {p['bg2']};
@define-color urgent {p['urgent']};
@define-color tooltip_bg {p['bg0']};
@define-color tooltip_border {p['bg3']};
@define-color battery_warn {p['yellow']};
@define-color battery_crit {p['urgent']};
@define-color cpucat {p['cyan']};
"""


def render_rofi_colors(p: dict) -> str:
    r, g, b = rgb(p["bg1"])
    r0, g0, b0 = rgb(p["bg0"])
    r3, g3, b3 = rgb(p["bg3"])
    # Two rofi rasi quirks are load-bearing here, both found the hard way:
    #   - a /* comment */ inside a block makes the parser choke, so every
    #     note lives in the header above the block instead
    #   - an underscore in a property name is rejected outright, hence
    #     windowBg rather than window_bg
    return f"""/* {p['name']}. Generated by theme-apply -- edit themes/{p['_slug']}/palette.conf.
 *
 * config.rasi references these and nothing else, so it never has to be
 * rewritten when the theme changes.
 *
 * The last six are not plain roles: the three surface colours carry alpha so
 * the window is translucent and the desktop shows through, and the rounded
 * corners only read because config.rasi keeps every inner container
 * transparent. selectedBg and onSelected are opaque, so a selected row still
 * reads over the translucency.
 *
 * The alpha values were 0.72 and 0.82, which was tuned when the blur was
 * strong enough to dissolve whatever was behind the panel. It is not: niri
 * 26.04's blur here is weak no matter what it is set to (see the blur block in
 * config/niri/config.kdl -- passes 2 and 3 are pixel-identical, and offset 8
 * and 16 differ by 326 pixels), so at 0.72 the backdrop stopped being a frosted
 * suggestion and became a smudge that competed with the menu text. Raising the
 * panel opacity is what actually makes it legible; 0.86 keeps the desktop
 * visible at the edges while the list itself stays readable over anything.
 * Lower these two together if you want more show-through. */
* {{
    bg0     : {p['bg0']};
    bg1     : {p['bg1']};
    bg2     : {p['bg2']};
    bg3     : {p['bg3']};

    fg0     : {p['fg0']};
    fg1     : {p['fg1']};
    fg2     : {p['fg2']};

    red     : {p['red']};
    green   : {p['green']};
    yellow  : {p['yellow']};
    blue    : {p['blue']};
    magenta : {p['magenta']};
    cyan    : {p['cyan']};
    orange  : {p['orange']};

    accent  : {p['accent']};
    urgent  : {p['urgent']};

    windowBg  : rgba({r} {g} {b} / 0.86);
    surfaceBg : rgba({r0} {g0} {b0} / 0.93);
    borderSoft : rgba({r3} {g3} {b3} / 0.80);
    selectedBg : {p['bg3']};
    onSelected : {p['fg0']};
    onUrgent   : {p['on_accent']};
}}
"""



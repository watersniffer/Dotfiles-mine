def render_qt6ct(p: dict) -> str:
    """qt6ct serialises the palette in Qt's QPalette::ColorRole order."""
    order = [
        ("Window", p["bg1"]), ("WindowText", p["fg0"]),
        ("Base", p["bg0"]), ("AlternateBase", p["bg2"]),
        ("ToolTipBase", p["bg0"]), ("ToolTipText", p["fg0"]),
        ("Text", p["fg0"]), ("Button", p["bg2"]),
        ("ButtonText", p["fg0"]), ("BrightText", p["fg0"]),
        ("Highlight", p["blue"]), ("HighlightedText", p["on_accent"]),
        ("Link", p["cyan"]), ("LinkVisited", p["magenta"]),
        ("Light", p["bg3"]), ("Midlight", p["bg4"]),
        ("Dark", p["bg0"]), ("Shadow", p["bg0"]),
        ("PlaceholderText", p["fg3"]),
        ("Accent", p["accent"]), ("AccentText", p["on_accent"]),
    ]
    inactive = [
        ("Window", p["bg1"]), ("WindowText", p["fg1"]),
        ("Base", p["bg0"]), ("AlternateBase", p["bg2"]),
        ("ToolTipBase", p["bg0"]), ("ToolTipText", p["fg1"]),
        ("Text", p["fg1"]), ("Button", p["bg2"]),
        ("ButtonText", p["fg1"]), ("BrightText", p["fg1"]),
        ("Highlight", p["bg3"]), ("HighlightedText", p["fg0"]),
        ("Link", p["fg3"]), ("LinkVisited", p["fg3"]),
        ("Light", p["bg3"]), ("Midlight", p["bg4"]),
        ("Dark", p["bg0"]), ("Shadow", p["bg0"]),
        ("PlaceholderText", p["fg3"]),
        ("Accent", p["fg3"]), ("AccentText", p["fg0"]),
    ]
    disabled = [
        ("Window", p["bg1"]), ("WindowText", p["fg3"]),
        ("Base", p["bg0"]), ("AlternateBase", p["bg2"]),
        ("ToolTipBase", p["bg0"]), ("ToolTipText", p["fg3"]),
        ("Text", p["fg3"]), ("Button", p["bg2"]),
        ("ButtonText", p["fg3"]), ("BrightText", p["fg3"]),
        ("Highlight", p["bg3"]), ("HighlightedText", p["fg0"]),
        ("Link", p["fg3"]), ("LinkVisited", p["fg3"]),
        ("Light", p["bg3"]), ("Midlight", p["bg4"]),
        ("Dark", p["bg0"]), ("Shadow", p["bg0"]),
        ("PlaceholderText", p["fg3"]),
        ("Accent", p["fg3"]), ("AccentText", p["fg0"]),
    ]

    def row(pairs: list) -> str:
        return ", ".join(qt(c) for _, c in pairs)

    names = ", ".join(n for n, _ in order)
    return f"""[ColorScheme]
# {p['name']}. Generated by theme-apply -- edit themes/{p['_slug']}/palette.conf.
#
# qt6ct serialises the arrays in Qt's QPalette::ColorRole order:
#   {names}
active_colors={row(order)}
inactive_colors={row(inactive)}
disabled_colors={row(disabled)}
"""


def render_mako(p: dict) -> str:
    return f"""# {p['name']}. Generated by theme-apply -- edit themes/{p['_slug']}/palette.conf.
font=Open Sans 9
background-color={p['bg0']}
text-color={p['fg0']}
border-color={p['accent']}
border-size=2
border-radius=10
padding=12
margin=8
default-timeout=5000
width=360
icons=1
max-icon-size=64
text-alignment=left

[urgency=low]
background-color={p['bg1']}
text-color={p['fg2']}
border-color={p['bg2']}
default-timeout=4000

[urgency=normal]
background-color={p['bg0']}
text-color={p['fg0']}
border-color={p['accent']}
default-timeout=6000

[urgency=critical]
background-color={p['bg1']}
text-color={p['fg0']}
border-color={p['urgent']}
"""


def render_wlogout(p: dict) -> str:
    """Full render: the only non-palette content is the fixed icon paths."""
    icons = {
        "lock": "lock.png",
        "logout": "logout.png",
        "suspend": "suspend.png",
        "hibernate": "hibernate.png",
        "shutdown": "shutdown.png",
        "reboot": "reboot.png",
    }
    rules = "\n".join(
        f"""  #{name} {{
      background-image: image(url("/usr/share/wlogout/icons/{file}"), url("/usr/local/share/wlogout/icons/{file}"));
  }}"""
        for name, file in icons.items()
    )
    return f"""/* {p['name']} Wlogout theme.
   Generated by theme-apply -- edit themes/{p['_slug']}/palette.conf. */
* {{
    background-image: none;
    box-shadow: none;
}}

window {{
    background-color: {rgba(p['bg1'], 0.96)};
}}

button {{
    border-radius: 10px;
    border-color: {p['bg3']};
    text-decoration-color: {p['fg0']};
    color: {p['fg0']};
    background-color: {p['bg1']};
    border-style: solid;
    border-width: 1px;
    background-repeat: no-repeat;
    background-position: center;
    background-size: 25%;
}}

button:focus,
button:active,
button:hover {{
    background-color: {p['bg2']};
    color: {p['accent']};
    outline-style: none;
}}

{rules}
"""


def render_lock(p: dict) -> str:
    return f"""# {p['name']} lock screen used by Niri.
# Generated by theme-apply -- edit themes/{p['_slug']}/palette.conf.
font=JetBrainsMono Nerd Font
color={p['bg0']}
text-color={p['fg0']}
indicator-radius=5
indicator-thickness=2
inside-color={p['bg2']}
line-color={p['accent']}
ring-color={p['accent']}
"""



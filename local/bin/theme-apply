theme[net_down]="{p['blue']}"

# Colors for processes box
theme[proc_box]="{p['cyan']}"
theme[proc_misc]="{p['fg3']}"
theme[proc_bar]="{p['blue']}"
theme[proc_bar_bg]="{p['bg2']}"
theme[proc_text]="{p['fg0']}"

# Colors for gpu box
theme[gpu_box]="{p['magenta']}"
theme[gpu_text]="{p['fg0']}"

# Colors for temp box
theme[temp_box]="{p['yellow']}"
theme[temp_text]="{p['fg0']}"
theme[temp_start]="{p['green']}"
theme[temp_mid]="{p['yellow']}"
theme[temp_end]="{p['urgent']}"

# Colors for fan box
theme[fan_box]="{p['cyan']}"
theme[fan_text]="{p['fg0']}"
theme[fan_speed]="{p['fg0']}"
theme[fan_start]="{p['green']}"
theme[fan_mid]="{p['yellow']}"
theme[fan_end]="{p['urgent']}"
"""


def render_lualine_table(p: dict, indent: str = "\t\t") -> str:
    rows = [
        ("base", p["bg0"]), ("mantle", p["bg1"]), ("crust", p["bg0"]),
        ("surface0", p["bg2"]), ("overlay0", p["fg3"]), ("text", p["fg0"]),
        ("subtext0", p["fg1"]), ("accent", p["accent"]),
        ("green", p["green"]), ("orange", p["yellow"]),
        ("yellow", p["yellow"]), ("red", p["urgent"]), ("blue", p["blue"]),
    ]
    body = "".join(f'{indent}\t{k} = "{v}",\n' for k, v in rows)
    return f"{indent}local colors = {{\n{body}{indent}}}"


# --------------------------------------------------------------------------
# patched files: only their colour properties change
# --------------------------------------------------------------------------

def patch_gtk4_root(path: Path, p: dict) -> bool:
    if not path.is_file():
        return False
    s = path.read_text(encoding="utf-8")
    wanted = {
        "--window-bg-color": p["bg0"],
        "--window-fg-color": p["fg0"],
        "--accent-bg-color": p["bg3"],
        "--accent-color": p["blue"],
        "--accent-fg-color": p["on_accent"],
    }
    for name, value in wanted.items():
        s, n = re.subn(rf"({re.escape(name)}\s*:\s*)#[0-9a-fA-F]{{6}}",
                       rf"\g<1>{value}", s)
        if n == 0:
            return False
    path.write_text(s, encoding="utf-8")
    return True


def patch_fastfetch(path: Path, p: dict) -> bool:
    """Recolour fastfetch's config in place.

    This file is a module list, not a palette: the logo source, the "break"
    separators, the per-module types and keyWidth all have to survive, so only
    the colour values are substituted. It also has to stay strict JSON --
    fastfetch's own parser rejects // comments despite the .jsonc name.
    """
    if not path.is_file():
        return False
    s = path.read_text(encoding="utf-8")

    # The logo's eight-colour ramp, keyed "1".."8".
    ramp = [p["accent"], p["urgent"], p["orange"], p["yellow"],
            p["green"], p["cyan"], p["blue"], p["magenta"]]
    for i, colour in enumerate(ramp, start=1):
        s, n = re.subn(rf'("{i}"\s*:\s*)"#[0-9a-fA-F]{{6}}"',
                       rf'\g<1>"{colour}"', s)
        if n == 0:
            return False

    # keyColor tints the module's label, color its value.
    for key, colour in (("keyColor", p["blue"]), ("color", p["fg0"])):
        s, n = re.subn(rf'("{key}"\s*:\s*)"#[0-9a-fA-F]{{6}}"',
                       rf'\g<1>"{colour}"', s)
        if n == 0:
            return False

    path.write_text(s, encoding="utf-8")
    return True


def patch_matuwall(path: Path, p: dict) -> bool:
    if not path.is_file():
        return False
    s = path.read_text(encoding="utf-8")
    wanted = {
        "tile": p["bg0"] + "ff",
        "border": p["bg3"] + "ff",
        "shadow": p["bg0"] + "99",
        "ring": p["accent"] + "ff",
        "spinner": p["cyan"] + "ff",
    }
    for key, value in wanted.items():
        s, n = re.subn(rf'(?m)^{key} = "#[0-9a-fA-F]{{8}}"',
                       f'{key} = "{value}"', s)
        if n == 0:
            return False
    path.write_text(s, encoding="utf-8")
    return True


def patch_niri_effects(path: Path, p: dict) -> bool:
    """Recolour the focus ring, border and shadow in place.

    The on/off state, widths and shadow metrics are the user's, not the
    theme's, so only the colour values are touched. The patterns are anchored
    to the start of a line so that active-color/inactive-color are not matched
    by the bare `color` rule.
    """
    if not path.is_file():
        return False
    s = path.read_text(encoding="utf-8")

    rules = [
        (r'(?m)^(\s*)active-color "#[0-9a-fA-F]{6}"',
         rf'\g<1>active-color "{p["accent"]}"'),
        (r'(?m)^(\s*)inactive-color "#[0-9a-fA-F]{6}"',
         rf'\g<1>inactive-color "{p["fg3"]}"'),
        (r'(?m)^(\s*)color "#[0-9a-fA-F]{8}"',
         rf'\g<1>color "{p["bg0"]}99"'),
    ]
    for pattern, repl in rules:
        s, n = re.subn(pattern, repl, s)
        if n == 0:
            return False
    path.write_text(s, encoding="utf-8")
    return True


def hypr_rgba(hex_color: str, alpha_hex: str = "ff") -> str:
    """Hyprland's colour form: rgba() with hex channels, not decimals.

    Waybar and GTK take rgba(30, 30, 46, 0.6); Hyprland takes rgba(1e1e2eff).
    The two are not interchangeable, hence a second helper rather than reusing
    rgba().
    """
    return f"rgba({hex_color.lstrip('#')}{alpha_hex})"


def patch_hyprland_palette(path: Path, p: dict) -> bool:
    """Recolour the `col_*` locals near the top of the Hyprland config.

    That block is the only part of the file that is theme-derived: the layout,
    opacity, gaps, rounding, shadow metrics and the keybinds are all the user's
    choices and are left alone. Each local is matched by name, so the order they
    appear in does not matter and an unused palette entry is harmless.
    """
    if not path.is_file():
        return False
    s = path.read_text(encoding="utf-8")

    wanted = {
        "col_bg0": p["bg0"],
        "col_bg1": p["bg1"],
        "col_bg3": p["bg3"],
        "col_fg0": p["fg0"],
        "col_accent": p["accent"],
        "col_urgent": p["urgent"],
    }
    for name, colour in wanted.items():
        s, n = re.subn(rf'(?m)^(local {name}\s*=\s*)"rgba\([0-9a-fA-F]+\)"',
                       rf'\g<1>"{hypr_rgba(colour)}"', s)
        if n == 0:
            return False
    path.write_text(s, encoding="utf-8")
    return True


def patch_lualine(path: Path, p: dict) -> bool:
    if not path.is_file():
        return False
    s = path.read_text(encoding="utf-8")
    new, n = re.subn(
        r"(?m)^([ \t]*)local colors = \{.*?^[ \t]*\}",
        lambda m: render_lualine_table(p, m.group(1)),
        s, count=1, flags=re.S)
    if n != 1:
        return False
    path.write_text(new, encoding="utf-8")
    return True


def patch_key(path: Path, pattern: str, value: str) -> bool:
    if not path.is_file():
        return False
    s = path.read_text(encoding="utf-8")
    new, n = re.subn(pattern, value, s, count=1, flags=re.M)
    if n != 1:
        return False
    path.write_text(new, encoding="utf-8")
    return True


# --------------------------------------------------------------------------
# obsidian
# --------------------------------------------------------------------------

# The seven Obsidian themes in the vault, mapped to the seven desktop palettes.
# The names are Obsidian's own ("Obsidian gruvbox", not "gruvbox") and have to
# match cssTheme in appearance.json exactly.
OBSIDIAN_THEMES = {
    "catppuccin-mocha": "Catppuccin",
    "e-ink": "Ink",
    "everforest-dark": "Everforest",
    "gruvbox-dark": "Obsidian gruvbox",
    "nord-dark": "Obsidian Nord",
    "rose-pine": "Rose Pine",
    "tokyo-night": "Tokyo Night",
}

# The vault lives outside the repo -- it is the user's notes, not dotfiles -- so
# it is reached by path rather than through CONFIG. Missing vault is not an
# error: someone may not have Obsidian set up, and the desktop theme should
# still apply to everything else.
VAULT = HOME / "doc" / "Sniffing-Vault"


def patch_obsidian(theme: str, written: list) -> bool:
    """Point the vault's Obsidian at the theme matching the desktop palette.

    This is the one target that is a whole JSON file rather than a config with
    colours in it, and it is rewritten rather than regex-patched, because
    cssTheme is a bare string whose length changes with the theme name and a
    pattern written against the old value would miss the new one.

    Obsidian reads appearance.json on focus, so a theme switch takes effect the
    next time the window is focused -- there is no reload to send it.
    """
    name = OBSIDIAN_THEMES.get(theme)
    if name is None:
        return False

    appearance = VAULT / ".obsidian" / "appearance.json"
    if not appearance.is_file():
        return False

    try:
        data = json.loads(appearance.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return False

    if data.get("cssTheme") == name:
        return False

    data["cssTheme"] = name
    appearance.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    # A label rather than a Path: the vault is outside the repo, so printing the
    # path in the summary would be noise, and this reads as what it is.
    written.append(Path(f"obsidian: {name}"))
    return True


# --------------------------------------------------------------------------
# wallpaper
# --------------------------------------------------------------------------

IMAGE_SUFFIXES = {".jpg", ".jpeg", ".png", ".webp"}


def wallpaper_images(folder: str) -> list[Path]:
    """Images sitting directly in a theme's wallpaper folder, in name order.

    Non-recursive on purpose: a theme folder should offer the wallpapers that
    belong to it, not everything someone once dropped in a subfolder of it.
    Sorted by name so the walk below is in the same order every time.
    """
    d = WALL_ROOT / folder
    if not d.is_dir():
        return []
    return sorted((p for p in d.iterdir()
                   if p.is_file() and p.suffix.lower() in IMAGE_SUFFIXES),
                  key=lambda p: p.name)


def next_wallpaper(slug: str, folder: str) -> Path | None:
    """The image after the last one this theme used, wrapping at the end.

    Round-robin rather than a random pick. Two reasons, both from what the
    folders actually hold: Nord has 207 images and Catppuccin 36, so a random
    pick lands on the same handful over and over and most images are never
    seen; and a random wallpaper on every theme switch cannot be reproduced,
    which makes "what did I just change this to" unanswerable. Walking in
    order shows every image once per lap and is predictable.

    The position is remembered per theme, so switching to Nord and back picks
    up where that theme left off rather than restarting at its first image.
    None means the folder is missing or empty, which is not an error: the
    caller reports it and carries on with the colours.
    """
    images = wallpaper_images(folder)
    if not images:
        return None

    marker = WALL_STATE / slug
    last = marker.read_text(encoding="utf-8").strip() if marker.is_file() else ""
    names = [p.name for p in images]

    if last in names:
        chosen = images[(names.index(last) + 1) % len(images)]
    else:
        # First visit, or the remembered image has since been deleted or
        # renamed: start again from the top rather than guessing.
        chosen = images[0]

    marker.parent.mkdir(parents=True, exist_ok=True)
    marker.write_text(chosen.name + "\n", encoding="utf-8")
    return chosen


def apply_wallpaper(path: Path) -> str:
    """Set the wallpaper with awww. Returns "" on success, else the reason.

    Called through the dotfiles shim by path rather than as a bare "awww",
    because the shim is what turns a plain image change into the expanding
    circle, and naming it explicitly means the transition does not depend on
    ~/.local/bin happening to be first on $PATH -- niri sets its own
    environment for keybind spawns, and that PATH is not guaranteed to match
    a login shell's.
    """
    shim = REPO / "local/bin/awww"
    awww = str(shim) if os.access(shim, os.X_OK) else "awww"

    try:
        proc = subprocess.run(
            [awww, "img", "--transition-duration", "1", "--", str(path)],
            capture_output=True, text=True, timeout=30)
    except subprocess.TimeoutExpired:
        return "awww timed out after 30s"
    except (OSError, subprocess.SubprocessError) as exc:
        return f"could not run awww ({exc})"

    if proc.returncode != 0:
        said = (proc.stderr or proc.stdout or "").strip().splitlines()
        return f"awww exited {proc.returncode}" + (f": {said[-1]}" if said else "")
    return ""


# --------------------------------------------------------------------------
# apply
# --------------------------------------------------------------------------

def write(path: Path, text: str, written: list) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")
    written.append(path)


def mirror(app: str, written: list) -> None:
    """Copy a repo config dir to its real (non-symlinked) live counterpart."""
    src, dst = MIRRORED[app], HOME / ".config" / app
    if not dst.is_dir():
        return
    for path in written:
        try:
            rel = path.relative_to(src)
        except ValueError:
            continue
        target = dst / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(path, target)


def run(cmd: list) -> None:
    try:
        subprocess.run(cmd, check=False, timeout=10,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        pass


def apply(slug: str, wallpaper: bool = True) -> int:
    p = load_palette(slug)
    p["_slug"] = slug
    camel = slug_to_camel(slug)
    written: list = []
    patched: list = []
    problems: list = []

    # Read before STATE is overwritten below, so "was this already the theme
    # in use" can still be answered when the wallpaper is chosen.
    previous = current()

    def do(fn, *args):
        if fn(*args):
            patched.append(args[0])
        else:
            problems.append(str(args[0].relative_to(REPO)))

    # --- rendered ---
    kitty = render_kitty(p)
    write(CONFIG / "waybar/colors.css", render_waybar_colors(p), written)
    write(CONFIG / "rofi/colors.rasi", render_rofi_colors(p), written)
    write(CONFIG / "kitty/current-theme.conf", kitty, written)
    write(CONFIG / f"kitty/themes/{slug}.conf", kitty, written)
    write(CONFIG / "gtk-3.0/colors.css", render_gtk_colors(p), written)
    write(CONFIG / "gtk-4.0/colors.css", render_gtk_colors(p), written)
    write(CONFIG / f"qt6ct/colors/{camel}.conf", render_qt6ct(p), written)
    write(CONFIG / "mako/config", render_mako(p), written)
    write(CONFIG / "wlogout/style.css", render_wlogout(p), written)
    write(CONFIG / "niri/lock.conf", render_lock(p), written)
    write(CONFIG / f"btop/themes/{p['btop']}.theme", render_btop(p), written)

    # --- patched ---
    do(patch_gtk4_root, CONFIG / "gtk-4.0/gtk.css", p)
    do(patch_matuwall, CONFIG / "matuwall/config.toml", p)
    do(patch_fastfetch, CONFIG / "fastfetch/config.jsonc", p)
    do(patch_niri_effects, CONFIG / "niri/config.kdl", p)
    do(patch_hyprland_palette, CONFIG / "hypr/hyprland.lua", p)
    do(patch_lualine, CONFIG / "nvim/lua/plugins/lualine.lua", p)
    do(patch_key, CONFIG / "nvim/current-theme.txt", r"^.*$", p["nvim"])
    do(patch_key, CONFIG / "btop/btop.conf",
       r'^color_theme = ".*"$', f'color_theme = "{p["btop"]}"')
    do(patch_key, CONFIG / "qt6ct/qt6ct.conf",
       r"^color_scheme_path=.*$",
       f"color_scheme_path=~/.config/qt6ct/colors/{camel}.conf")

    # The vault is not in the repo, so this is not a `do(...)` over CONFIG.
    # patch_obsidian adds itself to `written` when it changes something, which
    # is what makes it show up in the summary rather than failing silently.
    patch_obsidian(slug, written)

    # --- mirror to the real (non-symlinked) config dirs ---
    mirror("nvim", written)
    mirror("qt6ct", written)
    for path in patched:
        for app, src in MIRRORED.items():
            try:
                rel = path.relative_to(src)
            except ValueError:
                continue
            target = HOME / ".config" / app / rel
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(path, target)

    # VS Code's setting, when this palette wants to drive it. Optional: most
    # palettes leave it alone so the editor keeps whatever the user picked.
    # A wallpaper folder name is a single path segment under the wallpaper root.
    # It is rejected rather than sanitised if it looks like a path, because
    # quietly rewriting someone's folder name is worse than refusing.
    folder = p.get("wallpapers", "").strip()
    if folder and ("/" in folder or folder in (".", "..") or folder.startswith(".")):
        die(f"{slug}: wallpapers is {folder!r}, which is not a plain folder name")

    # VS Code gets a generated theme for this palette and is pointed at it, so
    # the editor follows along with everything else.
    vscode = render_vscode_theme(p)
    theme_dir = HOME / ".config/Code/User/themes"
    try:
        theme_dir.mkdir(parents=True, exist_ok=True)
        (theme_dir / f"{slug}.json").write_text(vscode, encoding="utf-8")
        written.append(theme_dir / f"{slug}.json")
    except OSError as exc:
        problems.append(f"Code themes dir ({exc.strerror})")

    # workbench.colorTheme has to match the theme file's "name" field exactly,
    # and for a file-based theme that name is what VS Code shows in the picker.
    vscode_name = f"Dotfiles: {p['name']}"
    if not set_vscode_theme(vscode_name):
        vscode_name = None
        problems.append("Code/User/settings.json")

    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(slug + "\n", encoding="utf-8")

    # --- reload what can be reloaded ---
    #
    # SIGUSR2 (reload config), not SIGUSR1 (reload style): under niri a
    # SIGUSR1 drops the bar onto the Bottom layer, where any window covers
    # it. SIGUSR2 re-reads the stylesheet and its @import of colors.css and
    # leaves the bar on the Top layer.
    run(["pkill", "-USR2", "-x", "waybar"])
    run(["pkill", "-x", "mako"])                      # config is startup-only
    subprocess.Popen(["mako"], stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)
    niri = os.environ.get("NIRI_SOCKET")
    if niri:
        run(["niri", "msg", "action", "load-config-file"])

    # Hyprland reads its palette from the config file, so it needs a reload.
    # Only when a session is actually up: hyprctl without an instance to talk
    # to would either fail or, worse, be run against whatever session happens to
    # be listening. The palette is written either way, so logging in after a
    # theme switch already shows the right colours.
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        run(["hyprctl", "reload"])


    # --- wallpaper ---
    #
    # Last, so the expanding circle plays over the palette that is already in
    # place rather than being covered by it a moment later.
    #
    # Re-applying the theme that is already active deliberately leaves the
    # wallpaper alone. themesw already refuses to re-apply the active theme,
    # so this only comes up when theme-apply is called directly, and there the
    # command means "make everything match this palette" -- advancing the
    # wallpaper as well would quietly make the same command do two different
    # things depending on the order you ran things in.
    if not wallpaper:
        wall_line = "  wallpaper: skipped (--no-wallpaper)"
    elif previous == slug:
        wall_line = "  wallpaper: left alone (that theme was already active)"
    elif not folder:
        wall_line = "  wallpaper: this theme names no folder"
    else:
        chosen = next_wallpaper(slug, folder)
        if chosen is None:
            wall_line = f"  wallpaper: {folder} holds no images"
        else:
            fault = apply_wallpaper(chosen)
            if fault:
                # Not added to `problems`: the colours did apply, and themesw
                # turns a non-zero exit into a "Theme switch failed" popup that
                # would be wrong. Same treatment as the nvim warning below.
                wall_line = f"  wallpaper: WARNING {chosen.name} did not apply ({fault})"
            else:
                wall_line = f"  wallpaper: {chosen.name}  (of {folder})"

    print(f"{p['name']} applied.")
    # The vault is outside the repo, so it is counted separately from the config
    # files: saying "rendered 14 files" when one of them is your notes would be
    # counting something the summary otherwise implies is dotfiles.
    vault_writes = [w for w in written if str(w).startswith("obsidian: ")]
    if vault_writes:
        print(f"  rendered {len(written) - len(vault_writes)} files, "
              f"patched {len(patched)}  (+{len(vault_writes)} vault: "
              f"{str(vault_writes[0]).removeprefix('obsidian: ')})")
    else:
        print(f"  rendered {len(written)} files, patched {len(patched)}")
    if vscode_name:
        print(f"  VS Code theme: {vscode_name}")
    print(wall_line)
    if not nvim_colorscheme_exists(p["nvim"]):
        print(f"  WARNING nvim has no colorscheme named {p['nvim']!r}. theme.lua "
              f"falls back to tokyonight, so nvim will not match the desktop. "
              f"Install the plugin, or point the palette's nvim role at one that "
              f"exists.")
    if problems:
        print("  NOT patched (pattern not found): " + ", ".join(problems))
    # Name the compositor that was actually reloaded rather than asserting a
    # fixed name, so this stays honest if the config is ever loaded outside a
    # session (e.g. by install.sh) rather than reporting a reload that did not
    # happen.
    reloaded = [n for n, cond in (("niri", os.environ.get("NIRI_SOCKET")),
                                   ("hyprland",
                                    os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")))
                if cond]
    print(f"  reloaded: waybar, mako, {', '.join(reloaded) if reloaded else 'none'}")
    print("  need a restart to pick it up: kitty, nvim, btop, "
          "and any running GTK/Qt app")
    return 1 if problems else 0


def current() -> str:
    if STATE.is_file():
        slug = STATE.read_text(encoding="utf-8").strip()
        if (THEMES_DIR / slug / "palette.conf").is_file():
            return slug
    return ""


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="theme-apply",
        description="Apply a desktop theme from themes/<slug>/palette.conf")
    ap.add_argument("theme", nargs="?",
                    help="theme slug, e.g. catppuccin-mocha")
    ap.add_argument("--list", action="store_true", help="list theme slugs")
    ap.add_argument("--current", action="store_true",
                    help="print the current theme slug")
    ap.add_argument("--wallpapers", action="store_true",
                    help="print the wallpaper folder for the current theme")
    ap.add_argument("--wallpapers-for", metavar="SLUG",
                    help="print the wallpaper folder a theme names, without "
                         "applying it")
    ap.add_argument("--no-wallpaper", action="store_true",
                    help="recolour the apps but leave the wallpaper alone; by "
                         "default a theme change also applies a wallpaper from "
                         "that theme's own folder")
    args = ap.parse_args()

    if args.list:
        for d in list_themes():
            pal = load_palette(d.name)
            marker = " *" if d.name == current() else ""
            print(f"{d.name:20} {pal['name']}{marker}")
        return 0

    if args.current:
        print(current())
        return 0

    if args.wallpapers:
        slug = current()
        if slug:
            folder = load_palette(slug).get("wallpapers", "").strip()
            if folder:
                print(folder)
        return 0

    if args.wallpapers_for:
        folder = load_palette(args.wallpapers_for).get("wallpapers", "").strip()
        if folder:
            print(folder)
        return 0

    if not args.theme:
        ap.error("give a theme slug, or --list / --current")

    return apply(args.theme, wallpaper=not args.no_wallpaper)


if __name__ == "__main__":
    raise SystemExit(main())

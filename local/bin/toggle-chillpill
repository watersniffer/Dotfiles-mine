#!/usr/bin/env bash
#
# Toggle ChillPill-Shell, the Hyprland session's bar (the niri session keeps
# waybar and local/bin/toggle-waybar).
#
# Scoped on purpose. ChillPill is launched by a wrapper that execs
# `qs -p /usr/share/chillpill-shell`, but this machine also has other
# Quickshell apps -- dankcalendar-git runs as a bare `qs` -- so the obvious
# `pkill -x qs` would take the calendar down along with the bar. Only the
# ChillPill process is matched.
#
# The bracket in the pattern is not a typo: it makes the regular expression
# match the literal text "chillpill-shell" while pgrep's own command line
# contains "chillpill[-]shell", which that expression does not match. Without it
# pgrep matches itself and the script kills its own caller.
#
#   toggle-chillpill   start the bar if it is down, stop it if it is up

set -uo pipefail

CP_PATTERN='qs -p /usr/share/chillpill[-]shell'

mapfile -t pids < <(pgrep -f "$CP_PATTERN" 2>/dev/null || true)

if ((${#pids[@]})); then
    kill "${pids[@]}" 2>/dev/null
    exit 0
fi

if ! command -v chillpill-shell >/dev/null 2>&1; then
    echo "toggle-chillpill: chillpill-shell is not installed" >&2
    exit 1
fi

setsid chillpill-shell >/dev/null 2>&1 &

#!/bin/sh
# toggle-scratchpad -- show the scratchpad, or put it away if it is already up.
#
# Bound to Super+S. Hyprland has no scratchpad, so the window is an ordinary kitty
# with the class "scratchpad", and the window rules in config/hypr/hyprland.lua make
# it borderless, gapless and undecorated. What is left is the toggle.
#
# Why a flag file rather than a dispatch
# --------------------------------------
# The obvious implementation is "if the window exists, close it", and every way of
# asking Hyprland to close a window is broken on this build. All of these were
# tried against a real window of the right class:
#
#   hyprctl dispatch killwindow class:scratchpad
#       -> hl.dispatch(killwindow class:scratchpad), which is not valid Lua
#   hyprctl eval 'return hl.dsp.window.close()'
#       -> answers "ok" and the window stays open
#   hyprctl eval 'return hl.dsp.close_window()'
#       -> "attempt to call a nil value"
#
# So the window closes itself instead. scratchpad-session, which kitty runs as the
# window's command, leaves a watcher running that kills kitty when this script drops
# the flag file. Reading the window list is fine -- `hyprctl clients -j` is a query,
# not a dispatch, and works -- so only the *closing* needed another route.

set -u

CLASS="scratchpad"
FLAG="${XDG_RUNTIME_DIR:-/tmp}/scratchpad-close"
HERE=$(dirname "$(realpath "$0")")

# Count windows of exactly this class. An exact match on .class, not a substring
# over the default hyprctl output, because that output includes window titles and a
# title containing the word would match an unrelated window.
running=$(hyprctl clients -j 2>/dev/null |
    jq -r --arg c "$CLASS" '[.[] | select(.class == $c)] | length' 2>/dev/null)

# An empty answer means hyprctl or jq failed. Treated as "not running" so the key
# still opens a window instead of silently doing nothing.
case $running in
    ''|*[!0-9]*) running=0 ;;
esac

if [ "$running" -gt 0 ]; then
    : > "$FLAG"
    exit 0
fi

# Opening. The flag is cleared first so a stale one from a window that was closed
# some other way -- the user typed `exit` -- cannot make the next scratchpad close
# itself the moment it appears.
rm -f "$FLAG"
exec kitty --class "$CLASS" -e "$HERE/scratchpad-session"

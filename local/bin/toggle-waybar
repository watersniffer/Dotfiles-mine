#!/usr/bin/env bash
set -euo pipefail

if pgrep -x waybar >/dev/null 2>&1; then
    pkill -x waybar
else
    desktop=${XDG_CURRENT_DESKTOP:-}
    if [[ -n "${WAYBAR_CONFIG:-}" ]]; then
        waybar_config=$WAYBAR_CONFIG
    elif [[ -n "${NIRI_SOCKET:-}" || "${desktop,,}" == niri* ]]; then
        waybar_config="$HOME/.config/waybar/config-niri.jsonc"
    else
        waybar_config="$HOME/.config/waybar/config.jsonc"
    fi

    setsid waybar -c "$waybar_config" -s "$HOME/.config/waybar/style.css" >/dev/null 2>&1 &
fi

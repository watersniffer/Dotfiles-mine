#!/usr/bin/env bash
#
# Toggle the session's bar. Bound to Super+Shift+W in config/hypr/hyprland.lua.
#
#   waybar running   killed, and started again on the next press.
#   neither          started.
#
# There used to be two branches here, one of which picked config-niri.jsonc when
# it saw a niri session. Niri is uninstalled, so that branch would have chosen a
# config file that no longer exists.
#
# Why it checks for ashell before deciding
# ----------------------------------------
# This used to treat "Hyprland session" as meaning ashell, and bail out with
# "ashell is not running; nothing to hide" when it was not. That made the bind do
# nothing at all on a Hyprland session running waybar, which is the case this
# desktop is actually in: the bar is waybar, ashell was removed from the setup,
# and the script had kept the assumption from when the opposite was true. It never
# reached the waybar code below at all.
#
# So the order is now "whichever bar is actually running", with the compositor
# only used to choose a config file when one has to be started. A session
# transition -- swapping ashell for waybar -- does not need this script edited,
# because it no longer has an opinion about which one the session is supposed to
# be using.
#
#   WAYBAR_CONFIG set   forces the waybar path and config whatever the session.
#
set -euo pipefail

desktop=${XDG_CURRENT_DESKTOP:-}
session=${desktop,,}

# In place, if ashell is the bar.
if pgrep -x ashell >/dev/null 2>&1; then
    exec ashell msg toggle-visibility
fi

if pgrep -x waybar >/dev/null 2>&1; then
    pkill -x waybar
    exit 0
fi

# Nothing running, so start one. Which config depends on the session, because
# waybar's workspace module is compositor-specific; the stylesheet is shared.
if [[ -n "${WAYBAR_CONFIG:-}" ]]; then
    waybar_config=$WAYBAR_CONFIG
elif [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" || "$session" == hyprland* ]]; then
    waybar_config="$HOME/.config/waybar/config-hypr.jsonc"
else
    # Rather than guessing a filename and producing a bar that fails to start,
    # say what is missing. An existing bar is never taken down on a guess.
    echo "toggle-waybar: not a hyprland session (XDG_CURRENT_DESKTOP=${desktop:-unset});" >&2
    echo "  set WAYBAR_CONFIG to a config file to override" >&2
    exit 1
fi

if [[ ! -r "$waybar_config" ]]; then
    echo "toggle-waybar: $waybar_config is missing" >&2
    exit 1
fi

# setsid so the bar outlives this script; without it the bar would be in the
# script's process group and could be taken down with it.
setsid waybar -c "$waybar_config" -s "$HOME/.config/waybar/style.css" >/dev/null 2>&1 &

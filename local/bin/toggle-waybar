#!/usr/bin/env bash
set -euo pipefail

if pgrep -x waybar >/dev/null 2>&1; then
    pkill -x waybar
else
    desktop=${XDG_CURRENT_DESKTOP:-}
    if [[ -n "${WAYBAR_CONFIG:-}" ]]; then
        waybar_config=$WAYBAR_CONFIG
    elif [[ -n "${NIRI_SOCKET:-}" || "${desktop,,}" == niri* ]]; then
        waybar_config="$HOME/.config/waybar/config-niri.jsonc"
    else
        waybar_config="$HOME/.config/waybar/config.jsonc"
    fi

    # Each session has its own stylesheet. They are not interchangeable: niri's
    # stylesheet styles niri/workspaces, custom/cpucat, wireplumber, backlight
    # and battery, none of which appear in the Hyprland one, so pointing niri
    # at style.css renders its bar with no styling at all. Both stylesheets
    # import the same colors.css, so the two bars still share one palette.
    if [[ $(basename "$waybar_config") == config-niri.jsonc ]]; then
        waybar_style="$HOME/.config/waybar/style-niri.css"
    else
        waybar_style="$HOME/.config/waybar/style.css"
    fi

    setsid waybar -c "$waybar_config" -s "$waybar_style" >/dev/null 2>&1 &
fi

#!/bin/bash

if [ $# -ne 1 ]; then
    echo "Error: A value must be provided."
    exit 1
fi

VALUE=${1%\%}
if ! [[ "$VALUE" =~ ^[+-]?[0-9]+$ ]]; then
    echo "Error: volume change must be an integer percentage."
    exit 1
fi

CURRENT_VOL=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null \
    | sed -n 's/.*[[:space:]]\([0-9]\+\)%.*/\1/p' | head -n 1)
if [[ -z "$CURRENT_VOL" ]]; then
    echo "Error: could not read the current sink volume."
    exit 1
fi
NEW_VOL=$((CURRENT_VOL + VALUE))

if [ "$NEW_VOL" -gt 200 ]; then
    NEW_VOL=200
elif [ "$NEW_VOL" -lt 0 ]; then
    NEW_VOL=0
fi

pactl set-sink-volume @DEFAULT_SINK@ "${NEW_VOL}%"

if [ "$NEW_VOL" -gt 70 ]; then
    ICON="notification-audio-volume-high"
elif [ "$NEW_VOL" -lt 40 ]; then
    ICON="notification-audio-volume-low"
else
    ICON="notification-audio-volume-medium"
fi

notify-send --app-name $0 --icon $ICON \
            "Volume changed" "Current volume: $NEW_VOL%"  \
            -h "string:x-canonical-private-synchronous:$0"

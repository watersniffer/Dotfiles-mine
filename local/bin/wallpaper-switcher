#!/usr/bin/env bash
#
# Open a wallpaper picker on ~/Pictures/Wallpapers.
#
# Simplified from the theme-aware version this replaced. It used to resolve a
# folder per theme from themes/<slug>/palette.conf and fall back to an ALL folder;
# the picker now points at one folder of hand-picked wallpapers, so that mapping
# is gone.
#
#   wallpaper-switcher            the picker on ~/Pictures/Wallpapers
#   wallpaper-switcher <folder>   a subfolder of it, by name
#
# matuwall still does the choosing and the preview, but its own backends are
# sweetbg / awww / auto -- none of which render an animated wallpaper. So it is
# started with its awww backend purely for the picking UI, and --no-hooks stops it
# painting, because what paints is local/bin/wallpaper-set calling hyprpaper.
# hyprpaper is mpv-based, which is why it was chosen: it renders animated webp,
# gif and video as well as stills.
#
# The two-step handoff matters. matuwall's on_apply hook runs after it has already
# handed the file to awww, so a hook cannot switch backends; the apply has to come
# from outside it. That is why the picker is not doing the setting here.

set -uo pipefail

SELF=$(basename "$0")
WALL_ROOT="$HOME/Pictures/Wallpapers"

say() { printf '%s: %s\n' "$SELF" "$*" >&2; }

count_images() {
    find "$1" -maxdepth 1 -type f \
        \( -iname '*.jpg' -o -iname '*.png' -o -iname '*.jpeg' \
           -o -iname '*.webp' -o -iname '*.gif' -o -iname '*.avif' \
           -o -iname '*.mp4' \) 2>/dev/null | wc -l
}

target=${1:-}
if [[ -z $target ]]; then
    dir="$WALL_ROOT"
else
    case $target in
        */*|.|..) say "give a subfolder name, not a path"; exit 2 ;;
    esac
    dir="$WALL_ROOT/$target"
fi

if [[ ! -d $dir ]]; then
    say "$dir does not exist"
    exit 1
fi

if [[ $(count_images "$dir") -eq 0 ]]; then
    say "$dir has no images in it yet"
    exit 1
fi

command -v hyprpaper >/dev/null 2>&1 || say "hyprpaper is not installed; animated wallpapers will not work"

# -b awww is only here so matuwall has a backend it can talk to while picking;
# --no-hooks stops it applying, so it never hands the file to awww behind
# hyprpaper's back. local/bin/wallpaper-set is what actually sets it.
exec matuwall --directory "$dir" --no-hooks -b awww \
     --hook "$HOME/.local/bin/wallpaper-set {}"

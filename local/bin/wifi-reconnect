#!/usr/bin/env bash
#
# wifi-reconnect -- rejoin a WPA2 network by password, and set it up so it stops
# flapping afterwards.
#
#   wifi-reconnect <ssid> <password>
#
# Why this exists rather than just "nmcli con up": the saved profile on this
# machine had become unusable and nmcli could not repair it in place.
#
# What was actually wrong
# ----------------------
# Two things, and the first one is the whole story:
#
# 1. Adapter power save was ON. That is the classic cause of a link that
#    associates, runs for a while, and is then dropped by the AP -- the repeating
#    connect/disconnect cycle this started with. It is now disabled system-wide
#    in /etc/NetworkManager/conf.d/99-wifi-powersave.conf rather than per-profile,
#    because the profile is what got recreated during the flapping, taking its own
#    settings with it. Measured: rx bitrate went from 6.0 MBit/s while flapping to
#    390-433 MBit/s stable.
#
# 2. That profile recreation also lost the password. NetworkManager keeps the PSK
#    in the profile file (root-only, mode 600), so with the profile rebuilt empty
#    every reconnection failed with "Secrets were required, but not provided" and
#    iwd reported deauthentication reason 23 -- IEEE 802.1X auth failed -- with
#    from_ap: true, which reads like the router rejecting the client and is the
#    opposite of what was happening.
#
# No secrets agent was involved. gnome-keyring is present on this machine only as a
# Mailspring dependency, and WiFi does not use it: the PSK lives in the profile, not
# in the keyring. An earlier diagnosis blamed the missing agent for the
# "Secrets were required" error, which was wrong -- that error just means the
# profile has no password in it.
#
# So the fix is to re-enter the password, which this script does, and to stop the
# flapping that loses it in the first place.

set -euo pipefail

ssid=${1:?usage: wifi-reconnect <ssid> <password>}
pass=${2:?usage: wifi-reconnect <ssid> <password>}
dev=${3:-wlan0}
echo "  joining $ssid on $dev"
sudo nmcli device wifi connect "$ssid" password "$pass" ifname "$dev"

# Persist the anti-flapping setting in the profile, not just on the interface.
sudo nmcli con mod "$ssid" 802-11-wireless.powersave 2
sudo iw dev "$dev" set power_save off 2>/dev/null || true

# Put the DNS override back, which was lost when the profile was recreated:
# 127.0.0.1 is dnsmasq, which serves the blocklist and forwards to Cloudflare.
sudo nmcli con mod "$ssid" ipv4.dns "127.0.0.1" ipv4.ignore-auto-dns yes
sudo nmcli con mod "$ssid" ipv6.ignore-auto-dns yes
sudo nmcli dev reapply "$dev" >/dev/null 2>&1 || true

sleep 3
state=$(nmcli -t -f DEVICE,STATE dev status | awk -F: -v d="$dev" '$1==d{print $2}')
echo "  $dev is now: $state"
iw dev "$dev" link 2>/dev/null | tr '\n' ' ' | sed 's/^/  /' || true
echo
echo "  verify: getent hosts pmvhaven.com   (expect 0.0.0.0)"

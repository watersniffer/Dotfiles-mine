[Unit]
Description=Force all CPU cores to performance governor on boot
After=sysinit.target
ConditionPathExistsGlob=/sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_governor

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'for c in /sys/devices/system/cpu/cpu[0-9]*; do echo performance > "$c/cpufreq/scaling_governor"; done'

[Install]
WantedBy=multi-user.target
